      "items": [
        {
          "id": "cognitive-01",
          "label": "積木を食べ物に見立てて人形に食べさせるなど、見立て遊び・ごっこ遊びをする"
        },
        {
          "id": "cognitive-02",
          "label": "物を取るために小さな踏み台の上に立つなど、簡単な問題解決をする"
