      "label": "認知・学習",
      "items": [
        {
          "id": "cognitive-01",
          "label": "お手本を見せると、丸（円）を描く"
        },
        {
          "id": "cognitive-02",
          "label": "「熱いよ」と注意すると、ストーブなどの熱いものに触らないように気をつける"
        }
      ]
    },
    {
