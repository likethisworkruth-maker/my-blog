---
import { getCollection } from 'astro:content';
import KnowhowDetailPage from '../../../components/KnowhowDetailPage.astro';
import { includeContentInCurrentBuild } from '../../../utils/content-publication';
import { sortKnowhowEntries } from '../../../scripts/knowhow-sort';

export async function getStaticPaths() {
	const knowhow = sortKnowhowEntries(await getCollection('knowhow', includeContentInCurrentBuild), 'recommend');
	return knowhow.map((item, index) => ({
		params: { id: item.id },
		props: {
			knowhow: item,
			prev: knowhow[index - 1] || null,
			next: knowhow[index + 1] || null,
		},
	}));
}

const { knowhow, prev, next } = Astro.props;
---

<KnowhowDetailPage knowhow={knowhow} prev={prev} next={next} detailTab="desc" />
