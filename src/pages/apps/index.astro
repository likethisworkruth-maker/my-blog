---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import RecommendBackLink from "../../components/RecommendBackLink.astro";
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
} from "../../consts";
import { UI } from "../../i18n/ja";

const apps = await getCollection("apps");
apps.sort((a, b) => a.data.order - b.data.order);

const uniqueCategories = [
	...new Set(
		apps.flatMap((app) => app.data.categories || []),
	),
];
const displayCategories = ["すべて", ...uniqueCategories];

const uniqueAges = [
	...new Set(
		apps
			.map((app) => app.data.childAgeMonths)
			.filter((age) => age !== undefined),
	),
].sort((a, b) => a! - b!);
---

<Layout
	title={`${UI.apps.pageTitle} | ${SITE_TITLE}`}
	description={SITE_DESCRIPTION}
>
	<div class="px-6 py-8 lg:py-12">
		<div class="mb-6"><RecommendBackLink label="アプリ" /></div>

		<!-- Search Bar -->
		<div class="relative mb-6">
			<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">search</span>
			<input type="text" id="app-search" placeholder="アプリ・サービスを検索" class="w-full bg-white border border-gray-200 rounded-xl py-3 sm:py-4 pl-12 pr-4 text-[0.95rem] focus:outline-none focus:border-mint-500 transition-colors" />
		</div>

		<div class="flex items-center justify-end gap-2 mb-8">
			<button
				type="button"
				id="open-filter-sheet-btn"
				class="inline-flex items-center gap-1.5 rounded-xl border border-gray-300 bg-white px-3.5 py-1.5 text-xs font-bold text-gray-700 transition-colors hover:bg-gray-50 active:scale-95"
			>
				<span class="material-symbols-outlined text-base">filter_alt</span>
				<span>絞り込み</span>
			</button>
			<button
				type="button"
				id="open-sort-sheet-btn"
				class="inline-flex items-center gap-1.5 rounded-xl border border-gray-300 bg-white px-3.5 py-1.5 text-xs font-bold text-gray-700 transition-colors hover:bg-gray-50 active:scale-95"
			>
				<span class="material-symbols-outlined text-base">swap_vert</span>
				<span>並び替え</span>
			</button>
		</div>

		<!-- App Grid -->
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6" id="apps-container" data-content-list data-list-empty="apps-empty" data-list-search="app-search" data-list-default-sort="recommended">
			{
				apps.map((app) => (
					<a
						href={`/apps/${app.id}/`}
						class="app-card flex flex-row items-center gap-4 bg-white p-4 lg:p-6 rounded-2xl hover:bg-gray-50 transition-colors border border-gray-100"
						data-list-card
						data-categories={(app.data.categories || []).join(",")}
						data-age={app.data.childAgeMonths ?? "none"}
						data-order={app.data.order}
						data-id={app.id}
					>
						<div class="w-16 h-16 sm:w-20 sm:h-20 rounded-[1.25rem] sm:rounded-3xl bg-orange-50 text-orange-400 flex items-center justify-center shrink-0 border border-gray-50">
							<span class="material-symbols-outlined text-3xl sm:text-4xl">
								{app.data.icon}
							</span>
						</div>

						<div class="flex-grow min-w-0 pr-2">
							<h3 class="text-[1rem] sm:text-[1.1rem] font-bold text-navy-900 truncate">
								{app.data.title}
							</h3>
							<p class="text-[0.8rem] sm:text-[0.85rem] text-gray-500 mt-1 line-clamp-2 leading-relaxed">
								{app.data.description}
							</p>
							{app.data.childAgeMonths !== undefined && (
								<div class="flex items-center gap-2 mt-1">
									<span class="text-[0.75rem] sm:text-[0.8rem] text-gray-500 truncate">
										生後{app.data.childAgeMonths}ヶ月〜
									</span>
								</div>
							)}
						</div>
					</a>
				))
			}
		</div>
		<div id="apps-empty" class="hidden rounded-xl border border-gray-200 bg-white px-6 py-10 text-center">
			<p class="text-sm font-bold text-gray-700">条件に一致するアプリはありません。</p>
		</div>
	</div>

	<!-- Filter & Sort Bottom Sheet Modal -->
	<dialog data-list-sheet id="filter-sheet-modal" class="fixed inset-0 z-[100] m-0 flex h-full max-h-none w-full max-w-none items-end bg-black/50 p-0 border-none outline-none backdrop-blur-sm transition-opacity duration-200 opacity-0 pointer-events-none overflow-hidden">
		<div data-list-sheet-content id="filter-sheet-content" class="w-full max-w-lg mx-auto rounded-t-3xl bg-white px-6 pb-6 pt-3 transition-transform duration-250 ease-out transform translate-y-full h-[80vh] max-h-[80vh] overflow-y-auto scrollbar-hide flex flex-col gap-5 border border-gray-200">
			<!-- Handle Bar -->
			<div class="w-full pt-1 pb-3 shrink-0 flex items-center justify-center cursor-grab active:cursor-grabbing touch-none select-none" id="close-sheet-handle" data-list-sheet-handle>
				<div class="w-12 h-1.5 bg-gray-300 rounded-full"></div>
			</div>

			<!-- Filter Section -->
			<div id="sheet-section-filter" class="flex flex-col gap-5">
				<div>
					<h3 class="font-bold text-gray-900 text-base mb-3">カテゴリー</h3>
					<div class="flex flex-wrap gap-2.5" id="sheet-category-group">
						{displayCategories.map((category) => (
							<button type="button" data-sheet-category={category} class="sheet-category-btn rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-all hover:bg-gray-50">{category}</button>
						))}
					</div>
				</div>
				<div>
					<h3 class="font-bold text-gray-900 text-base mb-3">対象月齢</h3>
					<div class="flex flex-wrap gap-2.5" id="sheet-age-group">
						<button type="button" data-sheet-age="all" class="sheet-age-btn rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-all hover:bg-gray-50">すべての対象</button>
						{uniqueAges.map((age) => (
							<button type="button" data-sheet-age={age.toString()} class="sheet-age-btn rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-all hover:bg-gray-50">生後{age}ヶ月向け</button>
						))}
						<button type="button" data-sheet-age="none" class="sheet-age-btn rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-all hover:bg-gray-50">月齢未指定</button>
					</div>
				</div>
			</div>

			<!-- Sort Section -->
			<div id="sheet-section-sort" class="flex flex-col gap-0 hidden">
				<h3 class="font-bold text-gray-900 text-base mb-2">並び替え</h3>
				<label class="flex items-center justify-between py-3.5 border-b border-gray-100 cursor-pointer group">
					<span class="text-sm font-bold text-gray-700 group-hover:text-gray-900">おすすめ順</span>
					<input type="radio" name="sheet-sort" value="recommended" class="w-4 h-4 text-mint-600 focus:ring-mint-500 border-gray-300" checked />
				</label>
				<label class="flex items-center justify-between py-3.5 border-b border-gray-100 cursor-pointer group">
					<span class="text-sm font-bold text-gray-700 group-hover:text-gray-900">月齢が低い順</span>
					<input type="radio" name="sheet-sort" value="age-asc" class="w-4 h-4 text-mint-600 focus:ring-mint-500 border-gray-300" />
				</label>
				<label class="flex items-center justify-between py-3.5 cursor-pointer group">
					<span class="text-sm font-bold text-gray-700 group-hover:text-gray-900">月齢が高い順</span>
					<input type="radio" name="sheet-sort" value="age-desc" class="w-4 h-4 text-mint-600 focus:ring-mint-500 border-gray-300" />
				</label>
			</div>

			<!-- Apply Button -->
			<div class="mt-auto pt-4 pb-2">
				<button type="button" id="sheet-apply-btn" class="w-full rounded-xl bg-mint-500 px-4 py-3.5 text-center text-sm font-bold text-white transition-colors hover:bg-mint-600 active:scale-95">絞り込む</button>
			</div>
		</div>
	</dialog>
</Layout>

<script>
	import { bootContentLists } from '../../scripts/list-page';
	bootContentLists();
</script>
