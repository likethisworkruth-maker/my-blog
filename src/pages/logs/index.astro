---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContentListControls from '../../components/ContentListControls.astro';
import ContentListSheet from '../../components/ContentListSheet.astro';
import LogCard from '../../components/LogCard.astro';
import RecommendBackLink from '../../components/RecommendBackLink.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { UI } from '../../i18n/ja';

const logs = await getCollection('logs');
logs.sort((a, b) => b.data.logNumber.localeCompare(a.data.logNumber));

const uniqueCategories = [...new Set(logs.flatMap(log => log.data.categories || []))];
const displayCategories = uniqueCategories.length > 0 ? ['すべて', ...uniqueCategories] : ['すべて', '子育て記録', '夫婦共有', '予定・健診', '離乳食'];

const uniqueAges = [...new Set(logs.map(log => log.data.childAgeMonths).filter((age): age is number => age !== undefined))].sort((a, b) => a - b);
---

<Layout title={`${UI.logs.pageTitle} | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<div class="px-6 py-8 lg:py-12">
		<div class="mb-6"><RecommendBackLink label="育児ログ" /></div>

		<ContentListControls
			searchId="log-search"
			searchLabel="子育てログを検索"
			searchPlaceholder="子育てログを検索"
		/>

		<div class="flex flex-col gap-0 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-6" id="logs-container" data-content-list data-list-empty="logs-empty" data-list-search="log-search" data-list-default-sort="newest">
			{logs.map((log) => <LogCard log={log} />)}
		</div>
		<div id="logs-empty" class="hidden rounded-xl border border-gray-200 bg-white px-6 py-10 text-center">
			<p class="text-sm font-bold text-gray-700">条件に一致する子育てログはありません。</p>
		</div>
	</div>

	<ContentListSheet categories={displayCategories} ages={uniqueAges} defaultSort="newest" />
</Layout>

<script>
	import { bootContentLists } from '../../scripts/list-page';
	bootContentLists();
</script>
