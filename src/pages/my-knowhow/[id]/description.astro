---
import { getCollection } from 'astro:content';
import KnowhowDetailPage from '../../../components/KnowhowDetailPage.astro';
import { includeContentInCurrentBuild } from '../../../utils/content-publication';
import { sortKnowhowEntries } from '../../../scripts/knowhow-sort';

export async function getStaticPaths() {
	const knowhow = sortKnowhowEntries(await getCollection('knowhow', includeContentInCurrentBuild), 'recommend');
	const navigationItems = knowhow
		.map((entry) => ({
			id: entry.id,
			checklistId: entry.data.checklistId,
			timelineOrder: entry.data.timelineOrder,
			childAgeMonths: entry.data.childAgeMonths,
			recommended: entry.data.recommended,
		}));
	return knowhow.map((item, index) => ({
		params: { id: item.id },
		props: {
			knowhow: item,
			prev: knowhow[index - 1] || null,
			next: knowhow[index + 1] || null,
			navigationItems,
		},
	}));
}

const { knowhow, prev, next, navigationItems = [] } = Astro.props;
---

<KnowhowDetailPage knowhow={knowhow} prev={prev} next={next} navigationItems={navigationItems} detailTab="desc" />
