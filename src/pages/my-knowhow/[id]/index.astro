---
import { getCollection } from 'astro:content';
import KnowhowDetailPage from '../../../components/KnowhowDetailPage.astro';

export async function getStaticPaths() {
	const knowhow = await getCollection('knowhow');
	const navigationItems = knowhow
		.map((entry) => ({ id: entry.id, checklistId: entry.data.checklistId, timelineOrder: entry.data.timelineOrder }))
		.sort((left, right) => left.timelineOrder - right.timelineOrder);
	return knowhow.map((item, index) => ({
		params: { id: item.id },
		props: {
			knowhow: item,
			prev: knowhow[index - 1] || null,
			next: knowhow[index + 1] || null,
			navigationItems,
		},
	}));
}

const { knowhow, prev, next, navigationItems = [] } = Astro.props;
---

<KnowhowDetailPage knowhow={knowhow} prev={prev} next={next} navigationItems={navigationItems} />
