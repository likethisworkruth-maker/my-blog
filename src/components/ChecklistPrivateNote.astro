---
interface Props {
	checklistId: string;
}

const { checklistId } = Astro.props;
---

<section class="private-note h-full overflow-y-auto bg-[#262626] p-4 text-gray-100 sm:p-6" data-private-note data-checklist-id={checklistId}>
	<div
		data-note-editor
		role="textbox"
		aria-label="メモ"
		aria-multiline="true"
		aria-disabled="true"
		contenteditable="false"
		tabindex="-1"
		data-placeholder="タップまたはクリックしてメモを書く"
		class="min-h-[60vh] w-full whitespace-pre-wrap break-words rounded-2xl px-1 py-2 text-base leading-8 text-white outline-none transition-colors focus:ring-1 focus:ring-mint-400/60"
	></div>
	<p data-note-save-state class="mt-2 hidden text-xs text-gray-400" aria-live="polite"></p>
</section>

<script>
	import {
		getActivePrivateChecklistRun,
		initializePrivateDb,
		savePrivateChecklistRun,
	} from '../scripts/private-db';
	import { onPageLoad } from '../scripts/page-lifecycle';

	function initPrivateNotes() {
		document.querySelectorAll<HTMLElement>('[data-private-note]').forEach((root) => {
			if (root.dataset.initialized) return;
			root.dataset.initialized = 'true';
			void initializePrivateNote(root);
		});
	}

	async function initializePrivateNote(root: HTMLElement) {
		const checklistId = root.dataset.checklistId;
		const editor = root.querySelector<HTMLElement>('[data-note-editor]');
		const state = root.querySelector<HTMLElement>('[data-note-save-state]');
		if (!checklistId || !editor) return;
		let timer: ReturnType<typeof setTimeout> | undefined;
		let loadSequence = 0;
		let run: Awaited<ReturnType<typeof getActivePrivateChecklistRun>> = null;

		const setState = (message: string, failed = false) => {
			if (!state) return;
			state.textContent = message;
			state.classList.toggle('hidden', !message);
			state.classList.toggle('text-red-300', failed);
			state.classList.toggle('text-gray-400', !failed);
		};
		const setEditorAvailability = (available: boolean) => {
			editor.contentEditable = available ? 'true' : 'false';
			editor.setAttribute('aria-disabled', String(!available));
			editor.tabIndex = available ? 0 : -1;
			editor.classList.toggle('cursor-text', available);
			editor.classList.toggle('cursor-not-allowed', !available);
			editor.classList.toggle('opacity-50', !available);
		};
		const readEditorText = () => (editor.innerText || editor.textContent || '')
			.replace(/\r\n/g, '\n')
			.replace(/\u00a0/g, ' ');
		const saveNote = async () => {
			try {
				const current = await getActivePrivateChecklistRun(checklistId);
				if (!current) return;
				current.note = readEditorText();
				await savePrivateChecklistRun(current);
				setState('');
			} catch {
				setState('保存に失敗しました', true);
			}
		};
		const loadRun = async () => {
			const sequence = ++loadSequence;
			try {
				await initializePrivateDb();
				const loadedRun = await getActivePrivateChecklistRun(checklistId);
				if (sequence !== loadSequence) return;
				run = loadedRun;
				setEditorAvailability(Boolean(run));
				editor.textContent = run?.note ?? '';
				setState(run ? '' : 'チェックリストを開始するとメモを入力できます');
			} catch {
				run = null;
				setEditorAvailability(false);
				setState('端末の保存データを読み込めませんでした', true);
			}
		};

		editor.addEventListener('input', () => {
			if (timer) clearTimeout(timer);
			timer = setTimeout(() => {
				timer = undefined;
				void saveNote();
			}, 400);
		});
		editor.addEventListener('blur', () => {
			if (timer) {
				clearTimeout(timer);
				timer = undefined;
				void saveNote();
			}
		});

		window.addEventListener('checklist-run-ready', () => void loadRun());
		window.addEventListener('checklist-runs-changed', () => {
			if (!editor.contains(document.activeElement)) void loadRun();
		});
		await loadRun();
	}

	onPageLoad(initPrivateNotes);
</script>

<style>
	[data-note-editor]:empty::before {
		content: attr(data-placeholder);
		color: rgb(156 163 175);
		pointer-events: none;
	}
</style>
