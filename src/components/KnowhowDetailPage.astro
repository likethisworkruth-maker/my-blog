---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import KnowhowBaseMedia from './KnowhowBaseMedia.astro';
import ChecklistRunner from './ChecklistRunner.astro';
import ChecklistPrivateNote from './ChecklistPrivateNote.astro';
import { SITE_TITLE } from '../consts';
import type { ChecklistTemplate } from '../scripts/checklist-state';

type DetailTab = 'base' | 'desc' | 'progress' | 'memo';

interface Props {
	knowhow: any;
	prev?: any;
	next?: any;
	navigationItems?: Array<{ id: string; checklistId: string; timelineOrder?: number }>;
	detailTab?: DetailTab;
}

const {
	knowhow,
	prev,
	next,
	navigationItems = [],
	detailTab = 'desc',
} = Astro.props as Props;
const { Content } = await render(knowhow);
const checklistEntry = await getEntry('checklists', knowhow.data.checklistId);
if (!checklistEntry || checklistEntry.data.status !== 'published') {
	throw new Error('公開中のチェックリスト原本がありません: ' + knowhow.data.checklistId);
}
const checklist = checklistEntry.data as ChecklistTemplate;
const isPrivateDetail = Astro.url.pathname.startsWith('/my-knowhow/');
const activeTab: DetailTab = detailTab;
const detailRoutePrefix = isPrivateDetail ? '/my-knowhow/' : '/knowhow/';
const privateBasePath = `/my-knowhow/${knowhow.id}/`;
const publicBasePath = `/knowhow/${knowhow.id}/`;
const tabUrls = {
	desc: `${isPrivateDetail ? privateBasePath : publicBasePath}description/`,
	progress: `${privateBasePath}progress/`,
	memo: `${privateBasePath}memo/`,
};
const navigationSuffix = activeTab === 'desc' ? 'description/' : activeTab === 'progress' ? 'progress/' : activeTab === 'memo' ? 'memo/' : '';
const navigationUrl = (id: string) => `${detailRoutePrefix}${id}/${navigationSuffix}`;
const prevUrl = prev ? navigationUrl(prev.id) : '';
const nextUrl = next ? navigationUrl(next.id) : '';
const templateJson = JSON.stringify(checklist).replace(/</g, '\\u003c');

const panelOpenClass = 'translate-y-0 lg:w-[400px] lg:opacity-100 lg:ml-0';
---

<Layout
	title={`${knowhow.data.title} | ${SITE_TITLE}`}
	description={knowhow.data.description}
	image={activeTab === 'base' ? knowhow.data.coverImage : undefined}
	fullScreen={true}
	showShareModal={activeTab === 'base'}
>
	<div
		class="relative flex h-[100dvh] w-full items-center justify-center overflow-hidden bg-[#111315]"
		id="knowhow-modal-container"
		data-knowhow-id={knowhow.id}
		data-checklist-id={checklist.checklistId}
		data-detail-tab={activeTab}
		data-prev={prevUrl}
		data-next={nextUrl}
		data-private-navigation={isPrivateDetail ? JSON.stringify(navigationItems) : undefined}
		data-private-state-loaded={isPrivateDetail ? 'false' : 'true'}
	>
		{activeTab === 'base' && (
			<button data-media-ui data-go-back class="fixed left-4 top-4 z-[80] flex h-10 w-10 items-center justify-center text-white outline-none transition-colors hover:text-gray-200 active:scale-95 lg:hidden" aria-label="チェックリスト一覧へ戻る">
				<span class="material-symbols-outlined text-[2rem] font-light drop-shadow-[0_2px_5px_rgba(0,0,0,0.8)]">arrow_back_ios_new</span>
			</button>
		)}

		<button data-media-ui data-go-back class="absolute left-6 top-6 z-50 hidden h-12 w-12 items-center justify-center text-white outline-none transition-colors hover:text-gray-300 lg:flex" aria-label="チェックリスト一覧へ戻る">
			<span class="material-symbols-outlined font-bold">arrow_back_ios_new</span>
		</button>

		<div id="main-content-wrapper" class="relative flex h-[100dvh] w-full max-w-[1200px] flex-row items-stretch justify-center transition-all duration-300 lg:h-[85dvh] lg:max-h-[900px] lg:py-6">
			{activeTab === 'base' && <KnowhowBaseMedia knowhow={knowhow} checklist={checklist} isPrivateDetail={isPrivateDetail} />}

			{activeTab !== 'base' && (
			<div
				id="info-panel"
				class={`fixed inset-0 z-[60] flex h-[100dvh] w-full flex-col overflow-hidden bg-[#262626] pb-[env(safe-area-inset-bottom)] opacity-100 shadow-2xl transition-all duration-300 ease-out lg:relative lg:inset-auto lg:h-full lg:z-10 lg:rounded-xl lg:pb-0 lg:shadow-xl ${panelOpenClass}`}
			>
				<div class="relative flex shrink-0 items-center justify-between border-b border-gray-600 bg-[#343434] pl-4 pr-14 pt-[env(safe-area-inset-top)] lg:pt-0">
					<nav id="detail-tabs" class="flex w-full flex-grow items-stretch justify-center" role="tablist" aria-label="チェックリストの詳細">
						<a id="tab-btn-desc" role="tab" aria-selected={activeTab === 'desc' ? 'true' : 'false'} aria-controls="tab-content-desc" tabindex={activeTab === 'desc' ? '0' : '-1'} href={tabUrls.desc} data-detail-nav data-panel-tab="desc" class={`flex h-14 flex-1 items-center justify-center whitespace-nowrap border-b-2 px-2 text-sm font-bold transition-colors sm:px-6 sm:text-base ${activeTab === 'desc' ? 'border-white text-white' : 'border-transparent text-gray-400'}`}>説明</a>
						{isPrivateDetail && (
							<>
								<a id="tab-btn-progress" role="tab" aria-selected={activeTab === 'progress' ? 'true' : 'false'} aria-controls="tab-content-progress" tabindex={activeTab === 'progress' ? '0' : '-1'} href={tabUrls.progress} data-private-tab data-detail-nav data-panel-tab="progress" class={`flex h-14 flex-1 items-center justify-center whitespace-nowrap border-b-2 px-2 text-sm font-bold transition-colors sm:px-4 sm:text-base ${activeTab === 'progress' ? 'border-white text-white' : 'border-transparent text-gray-400'}`}>進捗</a>
								<a id="tab-btn-memo" role="tab" aria-selected={activeTab === 'memo' ? 'true' : 'false'} aria-controls="tab-content-memo" tabindex={activeTab === 'memo' ? '0' : '-1'} href={tabUrls.memo} data-private-tab data-detail-nav data-panel-tab="memo" class={`flex h-14 flex-1 items-center justify-center whitespace-nowrap border-b-2 px-2 text-sm font-bold transition-colors sm:px-4 sm:text-base ${activeTab === 'memo' ? 'border-white text-white' : 'border-transparent text-gray-400'}`}>メモ</a>
							</>
						)}
					</nav>
					<button data-toggle-info class="absolute bottom-4 right-4 text-gray-300 hover:text-white" aria-label="詳細パネルを閉じる">
						<span class="material-symbols-outlined font-light">close</span>
					</button>
				</div>

				{activeTab === 'desc' && (
					<section id="tab-content-desc" role="tabpanel" aria-labelledby="tab-btn-desc" class="content-area min-w-[320px] flex-grow overflow-y-auto overscroll-contain bg-[#262626] p-4 text-gray-100 sm:p-6">
						<h1 class="mb-4 text-[1.25rem] font-bold leading-snug text-white">{knowhow.data.title}</h1>
						<p class="mb-6 whitespace-pre-wrap text-[0.95rem] leading-relaxed text-gray-300">{knowhow.data.description}</p>
						<Content />
						{!isPrivateDetail && (
							<button type="button" data-public-only data-start-checklist class="mt-7 w-full rounded-full bg-mint-500 px-6 py-3 text-sm font-bold text-white hover:bg-mint-600">このチェックリストを始める</button>
						)}
					</section>
				)}

				{activeTab === 'progress' && (
					<section id="tab-content-progress" role="tabpanel" aria-labelledby="tab-btn-progress" class="min-w-[320px] flex-grow overflow-hidden bg-[#262626]">
						<ChecklistRunner checklist={checklist} />
					</section>
				)}

				{activeTab === 'memo' && (
					<section id="tab-content-memo" role="tabpanel" aria-labelledby="tab-btn-memo" class="min-w-[320px] flex-grow overflow-hidden bg-[#262626]">
						<ChecklistPrivateNote checklistId={checklist.checklistId} />
					</section>
				)}
			</div>
			)}
		</div>
	</div>

	{(activeTab === 'base' || activeTab === 'desc') && <script is:inline type="application/json" data-checklist-template set:html={templateJson}></script>}
</Layout>

<script>
	import { navigate } from 'astro:transitions/client';
	import { createChecklistRun, type ChecklistTemplate } from '../scripts/checklist-state';
	import { getCurrentArticleLikeState, notifyArticleLikeChanged, setArticleLikeState } from '../scripts/article-likes';
	import { deletePrivateListByChecklistId } from '../scripts/private-list-delete';
	import {
		getPrivateChecklistRuns,
		getPrivateChecklistRunsByChecklistId,
		initializePrivateDb,
		savePrivateChecklistRun,
	} from '../scripts/private-db';
	import { readKnowhowListCache } from '../scripts/knowhow-list-cache';
	import { onPageLoad } from '../scripts/page-lifecycle';

	type DetailMode = 'public' | 'private';
	type DetailTab = 'base' | 'desc' | 'progress' | 'memo';

	declare global {
		interface Window {
			startChecklist: (options?: { skipLike?: boolean }) => Promise<void>;
			removeChecklistFromMyList: () => Promise<void>;
		}
	}

	document.addEventListener('astro:before-swap', (event) => {
		const direction = document.documentElement.dataset.scrollDirection;
		const transitionEvent = event as Event & { newDocument: Document };
		if (direction && transitionEvent.newDocument) {
			transitionEvent.newDocument.documentElement.dataset.scrollDirection = direction;
		}
	});

	function initDetailPage() {
		const container = document.getElementById('knowhow-modal-container');
		if (!container || container.dataset.reelsInitialized === 'true') return;
		container.dataset.reelsInitialized = 'true';

		const knowhowId = container.dataset.knowhowId ?? '';
		const checklistId = container.dataset.checklistId ?? '';
		const currentTab = (container.dataset.detailTab as DetailTab | undefined) ?? 'desc';
		const isPrivateDetailPath = window.location.pathname.startsWith('/my-knowhow/');
		const privateBasePath = `/my-knowhow/${knowhowId}/`;
		const publicBasePath = `/knowhow/${knowhowId}/`;
		const descriptionUrl = `${isPrivateDetailPath ? privateBasePath : publicBasePath}description/`;
		const legacyTab = new URLSearchParams(window.location.search).get('tab');
		if (isPrivateDetailPath && window.location.pathname === privateBasePath && legacyTab) {
			const legacyUrl = legacyTab === 'progress'
				? `${privateBasePath}progress/`
				: legacyTab === 'memo'
					? `${privateBasePath}memo/`
					: descriptionUrl;
			window.location.replace(legacyUrl);
			return;
		}
		let currentMode: DetailMode = isPrivateDetailPath || new URLSearchParams(window.location.search).get('mode') === 'my'
			? 'private'
			: 'public';
		let isNavigating = false;
		let removingChecklist = false;
		let startingChecklist = false;

		const infoPanel = () => document.getElementById('info-panel');

		const goBackFromKnowhow = () => {
			let returnUrl = '';
			try {
				returnUrl = sessionStorage.getItem('knowhow:return-url') ?? '';
				sessionStorage.removeItem('knowhow:return-url');
			} catch {
				// Session storage may be unavailable in strict privacy modes.
			}
			const destination = returnUrl.startsWith('/knowhow') || returnUrl.startsWith('/my-knowhow') ? returnUrl : '/';
			window.location.assign(destination);
		};

		const applyModeUi = () => {
			const isPrivate = currentMode === 'private';
			document.querySelectorAll<HTMLElement>('[data-public-actions]').forEach((element) => {
				element.classList.toggle('hidden', isPrivate);
				element.classList.toggle('contents', !isPrivate);
			});
			document.querySelectorAll<HTMLElement>('[data-private-actions]').forEach((element) => {
				element.classList.toggle('hidden', !isPrivate);
				element.classList.toggle('contents', isPrivate);
			});
			document.querySelectorAll<HTMLElement>('[data-public-only]').forEach((element) => element.classList.toggle('hidden', isPrivate));
			document.querySelectorAll<HTMLElement>('[data-private-only]').forEach((element) => element.classList.toggle('hidden', !isPrivate));
		};

		const getCachedPrivateListState = () => {
			if (!isPrivateDetailPath) return null;
			const cached = readKnowhowListCache();
			if (!cached || cached.view !== 'my') return null;
			try {
				const returnPath = sessionStorage.getItem('knowhow:return-url') ?? '';
				if (!returnPath.startsWith('/my-knowhow/') || cached.sourcePath !== returnPath) return null;
			} catch {
				return null;
			}
			return cached;
		};

		type DetailNavigationItem = { id: string; checklistId: string; timelineOrder?: number };
		const privateNavigationItems = (() => {
			try {
				const parsed = JSON.parse(container.dataset.privateNavigation ?? '[]') as unknown;
				const items = Array.isArray(parsed)
					? parsed.filter((item): item is DetailNavigationItem => (
						Boolean(item)
						&& typeof item === 'object'
						&& typeof (item as DetailNavigationItem).id === 'string'
						&& typeof (item as DetailNavigationItem).checklistId === 'string'
						&& (typeof (item as DetailNavigationItem).timelineOrder === 'undefined'
							|| typeof (item as DetailNavigationItem).timelineOrder === 'number')
					))
					: [];
				return items.sort((left, right) => (
					(left.timelineOrder ?? Number.MAX_SAFE_INTEGER) - (right.timelineOrder ?? Number.MAX_SAFE_INTEGER)
				));
			} catch {
				return [];
			}
		})();

		const privateNavigationUrl = (id: string) => {
			const suffix = currentTab === 'desc'
				? 'description/'
				: currentTab === 'progress'
					? 'progress/'
					: currentTab === 'memo'
						? 'memo/'
						: '';
			return `/my-knowhow/${id}/${suffix}`;
		};
		const clearPrivateNavigation = () => {
			if (!isPrivateDetailPath) return;
			container.removeAttribute('data-prev');
			container.removeAttribute('data-next');
		};
		const syncPrivateNavigation = (runs: Array<{ checklistId: string; isCompleted: boolean }>) => {
			if (!isPrivateDetailPath) return;
			const latestRuns = new Map<string, { checklistId: string; isCompleted: boolean }>();
			for (const run of runs) {
				if (!latestRuns.has(run.checklistId)) latestRuns.set(run.checklistId, run);
			}
			const activeChecklistIds = new Set(latestRuns.keys());
			const completedChecklistIds = new Set(
				Array.from(latestRuns.values()).filter((run) => run.isCompleted).map((run) => run.checklistId),
			);
			const cachedListState = getCachedPrivateListState();
			const navigationById = new Map(privateNavigationItems.map((item) => [item.id, item]));
			const isAvailablePrivateItem = (item: DetailNavigationItem) => (
				activeChecklistIds.has(item.checklistId)
					&& (!cachedListState || (
						cachedListState.completedOnly
							? completedChecklistIds.has(item.checklistId)
							: !completedChecklistIds.has(item.checklistId)
					))
			);
			const navigationItemsForView = cachedListState
				? cachedListState.orderedIds
					.map((id) => navigationById.get(id))
					.filter((item): item is DetailNavigationItem => Boolean(item && isAvailablePrivateItem(item)))
				: privateNavigationItems.filter((item) => activeChecklistIds.has(item.checklistId));
			const currentIndex = navigationItemsForView.findIndex((item) => item.id === knowhowId);
			if (currentIndex < 0) {
				clearPrivateNavigation();
				return;
			}
			const previous = navigationItemsForView[currentIndex - 1];
			const nextItem = navigationItemsForView[currentIndex + 1];
			if (previous) container.setAttribute('data-prev', privateNavigationUrl(previous.id));
			else container.removeAttribute('data-prev');
			if (nextItem) container.setAttribute('data-next', privateNavigationUrl(nextItem.id));
			else container.removeAttribute('data-next');
		};

		const navigateTo = (direction: 'next' | 'prev') => {
			if (isNavigating || (isPrivateDetailPath && container.dataset.privateStateLoaded !== 'true')) return;
			const url = container.getAttribute(`data-${direction}`);
			if (!url) return;
			isNavigating = true;
			document.documentElement.dataset.scrollDirection = direction;
			void navigate(url);
		};

		const mediaArea = document.getElementById('knowhow-media-area');
		mediaArea?.addEventListener('click', (event) => {
			const target = event.target as HTMLElement;
			if (target.closest('[data-media-ui], button, a, input, textarea, select, label, [role="button"]')) return;
			container.dataset.mediaChromeHidden = String(container.dataset.mediaChromeHidden !== 'true');
		});

		let wheelLocked = false;
		container.addEventListener('wheel', (event) => {
			const target = event.target as HTMLElement;
			const panel = infoPanel();
			if ((panel && panel.contains(target)) || wheelLocked) return;
			if (!event.deltaY) return;
			navigateTo(event.deltaY > 0 ? 'next' : 'prev');
			wheelLocked = true;
			window.setTimeout(() => { wheelLocked = false; }, 700);
		}, { passive: true });

		let touchStartY = 0;
		let touchEndY = 0;
		let touchMoved = false;
		container.addEventListener('touchstart', (event) => {
			touchStartY = event.touches[0]?.clientY ?? 0;
			touchEndY = touchStartY;
			touchMoved = false;
		}, { passive: true });
		container.addEventListener('touchmove', (event) => {
			touchEndY = event.touches[0]?.clientY ?? touchEndY;
			touchMoved = true;
		}, { passive: true });
		container.addEventListener('touchend', (event) => {
			const target = event.target as HTMLElement;
			const panel = infoPanel();
			if ((panel && panel.contains(target)) || target.closest('button, a, input, textarea, select, label, [role="button"], [contenteditable="true"]')) return;
			if (!touchMoved) return;
			const distance = touchStartY - touchEndY;
			if (distance > 50) navigateTo('next');
			else if (distance < -50) navigateTo('prev');
			touchMoved = false;
		});
		container.addEventListener('touchcancel', () => { touchMoved = false; }, { passive: true });

		const closeDetail = () => {
			void navigate(isPrivateDetailPath ? privateBasePath : publicBasePath);
		};

		const startChecklist = async (options?: { skipLike?: boolean }) => {
			if (startingChecklist) return;
			startingChecklist = true;
			try {
				const templateSource = container.parentElement?.parentElement?.querySelector<HTMLScriptElement>('[data-checklist-template]')
					?? document.querySelector<HTMLScriptElement>('[data-checklist-template]');
				if (!templateSource?.textContent) throw new Error('template-missing');
				const template = JSON.parse(templateSource.textContent) as ChecklistTemplate;
				await initializePrivateDb();
				const storedRuns = await getPrivateChecklistRunsByChecklistId(template.checklistId);
				const existing = storedRuns[0];
				if (!existing) await savePrivateChecklistRun(createChecklistRun(template));
				if (storedRuns.length === 0 && !options?.skipLike) {
					try {
						const likeState = await getCurrentArticleLikeState(`knowhow/${knowhowId}`);
						if (!likeState.liked) {
							notifyArticleLikeChanged(await setArticleLikeState(`knowhow/${knowhowId}`, true));
						}
					} catch {
						// Starting the checklist remains available when the like API is unavailable.
					}
				}
				await navigate(`${privateBasePath}progress/`);
			} catch {
				window.alert('チェックリストを開始できませんでした。端末の保存設定をご確認ください。');
			} finally {
				startingChecklist = false;
			}
		};
		window.startChecklist = startChecklist;

		window.removeChecklistFromMyList = async () => {
			if (removingChecklist || currentMode !== 'private' || !checklistId) return;
			removingChecklist = true;
			container.querySelectorAll<HTMLButtonElement>('[data-private-action-trigger]').forEach((button) => { button.disabled = true; });
			try {
				const deleted = await deletePrivateListByChecklistId(checklistId);
				if (deleted) await navigate('/my-knowhow/');
			} catch {
				window.alert('マイリストから削除できませんでした。もう一度お試しください。');
				removingChecklist = false;
				container.querySelectorAll<HTMLButtonElement>('[data-private-action-trigger]').forEach((button) => { button.disabled = false; });
			}
		};

		container.querySelectorAll<HTMLButtonElement>('[data-start-checklist], [data-start-checklist-action]').forEach((button) => {
			button.addEventListener('click', () => void startChecklist());
		});
		const startRequestHandler = (event: Event) => {
			const detail = (event as CustomEvent<{ slug?: string; skipLike?: boolean }>).detail;
			if (detail?.slug === `knowhow/${knowhowId}`) void startChecklist({ skipLike: detail.skipLike === true });
		};
		window.addEventListener('checklist-start-requested', startRequestHandler);

		container.addEventListener('click', (event) => {
			const target = event.target as HTMLElement;
			if (target.closest('[data-go-back]')) {
				goBackFromKnowhow();
				return;
			}
			if (target.closest('[data-remove-checklist]')) {
				void window.removeChecklistFromMyList();
				return;
			}
			if (target.closest('[data-toggle-info]')) {
				event.preventDefault();
				closeDetail();
				return;
			}
			const panelTarget = target.closest<HTMLElement>('[data-panel-tab]');
			if (panelTarget && !target.closest('a') && panelTarget.dataset.panelTab === 'desc') {
				event.preventDefault();
				void navigate(descriptionUrl);
			}
		});

		let startAfterOpen = false;
		let startAfterOpenSkipLike = false;
		try {
			if (sessionStorage.getItem('knowhow:start-after-open') === knowhowId) {
				startAfterOpen = true;
				startAfterOpenSkipLike = sessionStorage.getItem('knowhow:start-after-open-skip-like') === 'true';
				sessionStorage.removeItem('knowhow:start-after-open');
				sessionStorage.removeItem('knowhow:start-after-open-skip-like');
			}
		} catch {
			// Session storage may be unavailable in strict privacy modes.
		}

		const syncPrivateStateFromStoredRuns = async () => {
			try {
				await initializePrivateDb();
				const ownRuns = await getPrivateChecklistRunsByChecklistId(checklistId);
				const hasActiveRun = ownRuns.length > 0;
				if (isPrivateDetailPath) syncPrivateNavigation(await getPrivateChecklistRuns());
				if (hasActiveRun && currentMode === 'public') {
					currentMode = 'private';
					applyModeUi();
				}
			} catch {
				clearPrivateNavigation();
			} finally {
				container.dataset.privateStateLoaded = 'true';
				if (startAfterOpen) {
					startAfterOpen = false;
					void startChecklist({ skipLike: startAfterOpenSkipLike });
				}
			}
		};

		applyModeUi();
		void syncPrivateStateFromStoredRuns();
	}

	onPageLoad(() => {
		window.setTimeout(() => document.documentElement.removeAttribute('data-scroll-direction'), 500);
		initDetailPage();
	});
</script>

<style is:global>
	#knowhow-modal-container [data-media-ui] {
		transition: opacity 180ms ease, visibility 180ms ease;
	}

	#knowhow-modal-container[data-media-chrome-hidden="true"] [data-media-ui] {
		visibility: hidden;
		pointer-events: none;
		opacity: 0;
	}

	#caption-content h3, .content-area h3 { margin-top: 0.5rem; margin-bottom: 0.2rem; font-size: 1rem; font-weight: bold; }
	#caption-content p, .content-area p { margin-bottom: 0.5rem; }
	#caption-content a, .content-area a { color: #60a5fa; text-decoration: underline; }

	::view-transition-old(root),
	::view-transition-new(root) {
		animation: none;
	}

	::view-transition-group(knowhow-media) {
		animation-duration: 0.45s;
		animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
		overflow: hidden;
	}

	html[data-scroll-direction="next"]::view-transition-old(knowhow-media) { animation: slideUpOut 0.45s cubic-bezier(0.4, 0, 0.2, 1) both; }
	html[data-scroll-direction="next"]::view-transition-new(knowhow-media) { animation: slideUpIn 0.45s cubic-bezier(0.4, 0, 0.2, 1) both; }
	html[data-scroll-direction="prev"]::view-transition-old(knowhow-media) { animation: slideDownOut 0.45s cubic-bezier(0.4, 0, 0.2, 1) both; }
	html[data-scroll-direction="prev"]::view-transition-new(knowhow-media) { animation: slideDownIn 0.45s cubic-bezier(0.4, 0, 0.2, 1) both; }

