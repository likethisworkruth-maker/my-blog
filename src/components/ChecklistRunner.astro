---
import type { ChecklistTemplate } from '../scripts/checklist-state';

interface Props {
	checklist: ChecklistTemplate;
}

const { checklist } = Astro.props;
const templateJson = JSON.stringify(checklist).replace(/</g, '\\u003c');
---

<section class="checklist-runner h-full w-full min-w-0 overflow-y-auto bg-[#262626] text-gray-100" data-checklist-id={checklist.checklistId}>
	<script is:inline type="application/json" data-checklist-template set:html={templateJson}></script>

	<p data-checklist-loading class="py-10 text-center text-sm text-gray-400">端末の保存データを読み込んでいます…</p>

	<div data-checklist-missing class="m-4 hidden rounded-2xl border border-white/10 bg-white/5 p-5 text-center sm:m-6">
		<span class="material-symbols-outlined text-4xl text-gray-400" aria-hidden="true">playlist_add</span>
		<h2 class="mt-3 font-bold text-white">まだ開始されていません</h2>
		<p class="mt-2 text-sm leading-6 text-gray-400">この端末にチェックリストを作成すると、進捗を保存できます。</p>
		<button type="button" data-create-run class="mt-5 rounded-xl bg-mint-500 px-6 py-3 text-sm font-bold text-white hover:bg-mint-600">このリストを始める</button>
	</div>

	<div data-checklist-active class="hidden py-2">
		<p data-review-guidance class="mx-4 mb-3 hidden rounded-xl border border-mint-300/20 bg-mint-300/10 p-3 text-xs leading-5 text-mint-100">
			実際に使った結果を項目ごとに選んでください。回答はこの端末に保存されます。
		</p>
		<ul data-checklist-items class="border-t border-white/10"></ul>
		<div data-add-item-row class="flex min-h-14 items-center gap-3 border-b border-white/10 px-4">
			<button type="button" data-add-item-button class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-mint-500 text-[#262626] transition-colors hover:bg-mint-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint-500" aria-label="項目を追加">
				<span class="material-symbols-outlined text-xl" aria-hidden="true">add</span>
			</button>
			<div data-add-item-editor contenteditable="true" role="textbox" aria-label="項目を追加" data-placeholder="新規リマインダー" class="min-h-14 min-w-0 flex-1 py-4 text-[0.95rem] leading-6 text-white outline-none"></div>
		</div>
	</div>

	<p data-run-message class="mx-4 mt-3 min-h-5 text-center text-sm text-red-300" aria-live="assertive"></p>
</section>

<script>
	import {
		type ChecklistRun,
		type ChecklistRunItem,
		type ChecklistTemplate,
		createChecklistRun,
		createUuid,
	} from '../scripts/checklist-state';
	import {
		getActivePrivateChecklistRun,
		initializePrivateDb,
		savePrivateChecklistRun,
	} from '../scripts/private-db';
	import { onPageLoad } from '../scripts/page-lifecycle';

	function initChecklistRunners() {
		document.querySelectorAll<HTMLElement>('.checklist-runner').forEach((root) => {
			if (root.dataset.initialized) return;
			root.dataset.initialized = 'true';
			void initializeRunner(root);
		});
	}

	async function initializeRunner(root: HTMLElement) {
		const source = root.querySelector<HTMLScriptElement>('[data-checklist-template]');
		if (!source?.textContent) return;
		const template = JSON.parse(source.textContent) as ChecklistTemplate;
		const loading = root.querySelector<HTMLElement>('[data-checklist-loading]');
		const missing = root.querySelector<HTMLElement>('[data-checklist-missing]');
		const active = root.querySelector<HTMLElement>('[data-checklist-active]');
		const itemsContainer = root.querySelector<HTMLElement>('[data-checklist-items]');
		const addItemRow = root.querySelector<HTMLElement>('[data-add-item-row]');
		const addItemEditor = root.querySelector<HTMLElement>('[data-add-item-editor]');
		const addItemButton = root.querySelector<HTMLButtonElement>('[data-add-item-button]');
		const reviewGuidance = root.querySelector<HTMLElement>('[data-review-guidance]');
		const runMessage = root.querySelector<HTMLElement>('[data-run-message]');
		let run: ChecklistRun | null = null;
		let saveTimer: ReturnType<typeof setTimeout> | undefined;
		let saveChain: Promise<boolean> = Promise.resolve(true);

		const showError = (message: string) => {
			if (runMessage) runMessage.textContent = message;
		};
		const readSingleLine = (element: HTMLElement) => (element.innerText || element.textContent || '')
			.replace(/[\r\n]+/g, ' ')
			.replace(/\u00a0/g, ' ');
		const markEdited = (item?: ChecklistRunItem) => {
			if (!run) return;
			if (item) item.updatedAt = new Date().toISOString();
			if (run.status !== 'in_progress') {
				run.status = 'in_progress';
				run.preparedAt = undefined;
				run.reviewStartedAt = undefined;
				run.completedAt = undefined;
			}
		};
		const persist = () => {
			if (!run) return Promise.resolve(false);
			saveChain = saveChain.then(async () => {
				if (!run) return false;
				await savePrivateChecklistRun(run);
				return true;
			}).catch(() => {
				showError('保存に失敗しました');
				return false;
			});
			return saveChain;
		};
		const schedulePersist = () => {
			if (saveTimer) clearTimeout(saveTimer);
			saveTimer = setTimeout(() => {
				saveTimer = undefined;
				void persist();
			}, 350);
		};
		const persistImmediately = async () => {
			if (saveTimer) {
				clearTimeout(saveTimer);
				saveTimer = undefined;
			}
			await persist();
		};
		const cancelPendingSave = () => {
			if (!saveTimer) return;
			clearTimeout(saveTimer);
			saveTimer = undefined;
		};

		const updateCheckedStyle = (row: HTMLElement, item: ChecklistRunItem) => {
			const text = row.querySelector<HTMLElement>('[data-item-editor], [data-item-label]');
			text?.classList.toggle('text-gray-500', item.checked);
			text?.classList.toggle('line-through', item.checked);
		};

		const createItemEditor = (item: ChecklistRunItem, row: HTMLElement) => {
			const editor = document.createElement('div');
			editor.contentEditable = 'true';
			editor.role = 'textbox';
			editor.dataset.itemEditor = item.id;
			editor.dataset.placeholder = '項目名を入力';
			editor.setAttribute('aria-label', `${item.label || '項目'}を編集`);
			editor.className = 'min-w-0 flex-1 py-4 text-[0.95rem] font-normal leading-6 text-white outline-none';
			editor.textContent = item.label;
			editor.addEventListener('input', () => {
				item.label = readSingleLine(editor);
				markEdited(item);
				updateCheckedStyle(row, item);
				schedulePersist();
			});
			editor.addEventListener('keydown', (event) => {
				if (event.key === 'Enter') event.preventDefault();
			});
			editor.addEventListener('blur', () => { void persistImmediately(); });
			return editor;
		};

		const createReviewSelect = (item: ChecklistRunItem) => {
			const review = document.createElement('label');
			review.className = 'mt-2 flex items-center justify-between gap-3 border-t border-white/10 pt-3 text-xs text-gray-300';
			const prompt = document.createElement('span');
			prompt.textContent = '実際の結果';
			const select = document.createElement('select');
			select.className = 'max-w-[70%] rounded-lg border border-white/15 bg-[#343434] px-2 py-1.5 text-xs text-white focus:border-mint-400 focus:outline-none disabled:opacity-60';
			select.disabled = run?.status === 'completed';
			const outcomes: Array<[string, string]> = [
				['', '選択してください'],
				['used', '実際に使った'],
				['unused', '持っていったが使わなかった'],
				['missed', '持たずに困った'],
				['remove_next', '次回はいらない'],
			];
			if (item.origin === 'custom') outcomes.push(['custom_helpful', '自分で追加して役立った']);
			for (const [value, label] of outcomes) {
				const option = document.createElement('option');
				option.value = value;
				option.textContent = label;
				option.selected = item.outcome === value || (!item.outcome && value === '');
				select.append(option);
			}
			select.addEventListener('change', () => {
				item.outcome = select.value ? select.value as ChecklistRunItem['outcome'] : undefined;
				item.updatedAt = new Date().toISOString();
				void persist();
			});
			review.append(prompt, select);
			return review;
		};

		const renderItem = (item: ChecklistRunItem) => {
			const row = document.createElement('li');
			row.dataset.checklistItemId = item.id;
			row.className = 'checklist-item-row border-b border-white/10 bg-transparent px-4';
			const line = document.createElement('div');
			line.className = 'flex min-h-14 min-w-0 items-start gap-3';
			const checkbox = document.createElement('input');
			checkbox.type = 'checkbox';
			checkbox.checked = item.checked;
			checkbox.disabled = run?.status === 'completed';
			checkbox.className = 'reminder-checkbox mt-4 h-6 w-6 shrink-0';
			checkbox.setAttribute('aria-label', `${item.label}を完了にする`);
			checkbox.addEventListener('change', () => {
				item.checked = checkbox.checked;
				item.checkedAt = item.checked ? new Date().toISOString() : undefined;
				markEdited(item);
				updateCheckedStyle(row, item);
				void persist();
			});
			const reviewLocked = run?.status === 'review_pending' || run?.status === 'completed';
			const text = reviewLocked
				? document.createElement('span')
				: createItemEditor(item, row);
			if (reviewLocked) {
				text.dataset.itemLabel = 'true';
				text.className = 'min-w-0 flex-1 py-4 text-[0.95rem] font-normal leading-6 text-white';
				text.textContent = item.label;
			}
			line.append(checkbox, text);
			row.append(line);
			updateCheckedStyle(row, item);
			if (run?.status === 'review_pending' || run?.status === 'completed') row.append(createReviewSelect(item));
			return row;
		};

		const addItem = async () => {
			if (!run || !addItemEditor || run.status === 'review_pending' || run.status === 'completed') return;
			const label = readSingleLine(addItemEditor).trim();
			if (!label) return;
			const now = new Date().toISOString();
			run.items.push({
				id: createUuid(),
				itemKey: `custom-${createUuid()}`,
				groupId: 'custom',
				groupLabel: '自分用',
				label,
				origin: 'custom',
				phase: 'prepare',
				order: run.items.length,
				checked: false,
				hidden: false,
				note: '',
				updatedAt: now,
			});
			addItemEditor.textContent = '';
			markEdited();
			render();
			await persistImmediately();
		};

		const render = () => {
			loading?.classList.add('hidden');
			missing?.classList.toggle('hidden', Boolean(run));
			active?.classList.toggle('hidden', !run);
			if (!run) return;
			const visible = run.items.filter((item) => !item.hidden).sort((a, b) => a.order - b.order);
			itemsContainer?.replaceChildren(...visible.map(renderItem));
			const reviewLocked = run.status === 'review_pending' || run.status === 'completed';
			addItemRow?.classList.toggle('hidden', reviewLocked);
			reviewGuidance?.classList.toggle('hidden', run.status !== 'review_pending');
		};

		addItemButton?.addEventListener('click', () => { void addItem(); });
		addItemEditor?.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter') return;
			event.preventDefault();
			void addItem();
		});
		addItemEditor?.addEventListener('blur', () => {
			if (readSingleLine(addItemEditor).trim()) void addItem();
		});
		window.addEventListener('checklist-edit-cancel', cancelPendingSave);
		document.addEventListener('astro:before-swap', cancelPendingSave, { once: true });
		window.addEventListener('pagehide', cancelPendingSave, { once: true });

		try {
			await initializePrivateDb();
			run = await getActivePrivateChecklistRun(template.checklistId);
			render();
		} catch {
			loading?.classList.add('hidden');
			showError('このブラウザーでは端末の保存データを読み込めませんでした。');
		}

		root.querySelector<HTMLButtonElement>('[data-create-run]')?.addEventListener('click', async () => {
			try {
				run = createChecklistRun(template);
				await savePrivateChecklistRun(run);
				window.dispatchEvent(new CustomEvent('checklist-run-ready', { detail: { checklistId: template.checklistId } }));
				render();
			} catch {
				run = null;
				showError('端末への保存を開始できませんでした。');
			}
		});
	}

	onPageLoad(initChecklistRunners);
</script>

<style is:global>
	.checklist-runner {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	.checklist-runner::-webkit-scrollbar {
		display: none;
	}

	.checklist-runner [data-item-editor]:empty::before,
	.checklist-runner [data-add-item-editor]:empty::before {
		content: attr(data-placeholder);
		color: rgb(148 163 184);
		pointer-events: none;
	}

	.checklist-runner .checklist-item-row {
		transition: border-color 140ms ease;
	}

	.checklist-runner .reminder-checkbox {
		display: grid;
		appearance: none;
		place-content: center;
		border: 1.5px solid rgb(148 163 184);
		border-radius: 9999px;
		background: transparent;
		cursor: pointer;
		transition: border-color 140ms ease, background-color 140ms ease;
	}

	.checklist-runner .reminder-checkbox::before {
		width: 0.65rem;
		height: 0.35rem;
		content: '';
		border-bottom: 2px solid white;
		border-left: 2px solid white;
		transform: translateY(-1px) rotate(-45deg) scale(0);
		transition: transform 120ms ease;
	}

	.checklist-runner .reminder-checkbox:checked {
		border-color: var(--color-mint-500);
		background-color: var(--color-mint-500);
	}

	.checklist-runner .reminder-checkbox:checked::before {
		transform: translateY(-1px) rotate(-45deg) scale(1);
	}

	.checklist-runner .reminder-checkbox:focus-visible {
		outline: 2px solid var(--color-mint-500);
		outline-offset: 2px;
	}

	.checklist-runner .reminder-checkbox:disabled {
		cursor: default;
		opacity: 0.55;
	}
</style>
