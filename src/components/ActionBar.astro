---
import LikeButton from './LikeButton.astro';

interface Props {
	slug: string;
	variant?: 'default' | 'feed' | 'reels';
	checklistId?: string;
	startOnLike?: boolean;
	privateDetail?: boolean;
	activeTab?: 'base' | 'desc' | 'progress' | 'memo';
}

const {
	slug,
	variant = 'default',
	checklistId,
	startOnLike = false,
	privateDetail = false,
	activeTab = 'desc',
} = Astro.props;
const id = slug.split('/')[1];
const privateDetailUrl = '/my-knowhow/' + id + '/';
const privateDescriptionUrl = privateDetailUrl + 'description/';
const privateProgressUrl = privateDetailUrl + 'progress/';
const privateMemoUrl = privateDetailUrl + 'memo/';
const showShare = !slug.startsWith('knowhow/');
---

{variant === 'reels' ? (
	<div class="flex flex-col items-center gap-6">
		<LikeButton slug={slug} variant="reels" startOnLike={startOnLike} />
		<div data-public-actions class={privateDetail ? 'hidden' : 'contents'}>
			<button
				class="hidden flex-col items-center text-white hover:text-gray-200 transition-colors active:scale-95"
				data-panel-tab="comments"
			>
				<span class="material-symbols-outlined icon-text-shadow text-[2rem] font-light" style="font-variation-settings: 'FILL' 1;">chat_bubble</span>
				<span class="icon-text-shadow text-[0.75rem] font-medium mt-1">コメント</span>
			</button>
			{checklistId && (
				<button data-start-checklist-action class="relative flex flex-col items-center text-white hover:text-gray-200 transition-colors active:scale-95" aria-label="このチェックリストを始める">
					<span class="material-symbols-outlined icon-text-shadow text-[2rem] font-light">playlist_add</span>
					<span class="icon-text-shadow mt-1 text-[0.75rem] font-medium">始める</span>
				</button>
			)}
		</div>
		<div data-private-actions class={privateDetail ? 'contents' : 'hidden'}>
			<button data-private-action-trigger data-private-list-delete data-remove-checklist class="relative flex flex-col items-center text-white hover:text-gray-200 transition-colors active:scale-95" aria-label="このチェックリストをマイリストから削除">
				<span class="material-symbols-outlined icon-text-shadow text-[2rem] font-light">delete</span>
				<span class="icon-text-shadow mt-1 text-[0.75rem] font-medium">削除</span>
			</button>
			<a href={privateDescriptionUrl} data-panel-trigger data-panel-tab="desc" data-detail-nav class:list-active={activeTab === 'desc'} class="relative flex flex-col items-center text-white hover:text-gray-200 transition-colors active:scale-95" aria-label="チェックリストの説明を開く" aria-current={activeTab === 'desc' ? 'page' : undefined}>
				<span class="material-symbols-outlined icon-text-shadow text-[2rem] font-light">info</span>
				<span class="icon-text-shadow mt-1 text-[0.75rem] font-medium">説明</span>
			</a>
			<a href={privateProgressUrl} data-panel-trigger data-panel-tab="progress" data-detail-nav class:list-active={activeTab === 'progress'} class="relative flex flex-col items-center text-white hover:text-gray-200 transition-colors active:scale-95" aria-label="チェックリストの進捗を開く" aria-current={activeTab === 'progress' ? 'page' : undefined}>
				<span class="material-symbols-outlined icon-text-shadow text-[2rem] font-light">checklist</span>
				<span class="icon-text-shadow mt-1 text-[0.75rem] font-medium">進捗</span>
			</a>
			<a href={privateMemoUrl} data-panel-trigger data-panel-tab="memo" data-private-memo-route={privateMemoUrl} data-detail-nav class:list-active={activeTab === 'memo'} class="relative flex flex-col items-center text-white hover:text-gray-200 transition-colors active:scale-95" aria-label="このチェックリストのメモを開く" aria-current={activeTab === 'memo' ? 'page' : undefined}>
					<span class="material-symbols-outlined icon-text-shadow text-[2rem] font-light">edit_note</span>
					<span class="icon-text-shadow mt-1 text-[0.75rem] font-medium">メモ</span>
			</a>
		</div>
		{showShare && (
			<button class="flex flex-col items-center text-white hover:text-gray-200 transition-colors active:scale-95" data-share-trigger aria-label="このページを共有">
				<span class="material-symbols-outlined icon-text-shadow text-[2rem] font-light">send</span>
				<span class="icon-text-shadow text-[0.75rem] font-medium mt-1">シェア</span>
			</button>
		)}
	</div>
) : (
	<div class={`flex items-center justify-start gap-3 ${variant === 'default' ? 'my-12 pt-8 border-t border-gray-100' : 'my-3'}`}>
		<LikeButton slug={slug} />
		{showShare && (
			<button class="flex h-8 w-8 items-center justify-center text-gray-400 transition-colors hover:text-mint-600 active:scale-95" data-share-trigger aria-label="このページを共有">
				<span class="material-symbols-outlined text-[1.5rem] font-light" aria-hidden="true">send</span>
			</button>
		)}
	</div>
)}
