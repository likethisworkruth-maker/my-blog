---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import LikeButton from "./LikeButton.astro";
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
} from "../consts";
import { UI } from "../i18n/ja";

const knowhow = await getCollection("knowhow");
knowhow.sort((a, b) => a.data.timelineOrder - b.data.timelineOrder);

const phaseIds = Array.from(new Set(knowhow.flatMap((post) => post.data.phases))).sort((a, b) => {
	const phaseSortKey = (phase: string) => {
		if (phase === "pregnancy") return -1;
		const monthStart = Number(phase.match(/^(\d+)-/)?.[1] ?? NaN);
		if (Number.isFinite(monthStart)) return monthStart;
		const yearStart = Number(phase.match(/^(\d+)y/)?.[1] ?? NaN);
		return Number.isFinite(yearStart) ? yearStart * 12 : Number.MAX_SAFE_INTEGER;
	};
	return phaseSortKey(a) - phaseSortKey(b);
});

const sceneLabels = Array.from(new Set(knowhow.flatMap((post) => post.data.scenes)));

const getPhaseLabel = (phase: string) => {
	if (phase === "pregnancy") return "妊娠中";
	const monthRange = phase.match(/^(\d+)-(\d+)m$/);
	if (monthRange) return monthRange[1] + "〜" + monthRange[2] + "か月";
	const yearRange = phase.match(/^(\d+)y-plus$/);
	if (yearRange) return yearRange[1] + "歳〜";
	return phase;
};

const phases = [
	...phaseIds.map((id) => ({ id, label: getPhaseLabel(id) })),
];

const scenes = sceneLabels.map((label) => ({ label }));
const filterOptions = { phases, scenes };
const isRootPage = Astro.url.pathname === "/";
const isMyListPage = Astro.url.pathname.startsWith("/my-knowhow");
const getInitialDisplayMode = (mode: string | null) => (
	mode === "grid_view" || mode === "grid" || mode === "gallery" ? "grid_view" : "headline_view"
);
const initialDisplayMode = getInitialDisplayMode(
	Astro.url.searchParams.get("mode") ?? Astro.url.searchParams.get("view_mode"),
);
---

<Layout
	title={isRootPage ? SITE_TITLE : `${UI.knowhow.pageTitle} | ${SITE_TITLE}`}
	description={SITE_DESCRIPTION}
	initialDisplayMode={initialDisplayMode}
>
	<div class="mx-auto flex max-w-3xl flex-col gap-6 px-4 py-6 lg:py-10">
		<!-- Header Search & Filter Navigation Area -->
		<div class="flex flex-col gap-3">
			<!-- Search Input Box -->
			<div class="relative w-full">
				<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xl pointer-events-none" aria-hidden="true">search</span>
				<input
					type="search"
					id="search-keyword-input"
					placeholder="キーワードで検索"
					class="w-full rounded-full border border-gray-200 bg-white py-2.5 pl-11 pr-4 text-sm text-navy-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100 transition-all placeholder:text-gray-400"
				/>
			</div>

			<!-- Sub Actions (Filter & Sort Buttons & Display View Toggle) -->
			<div class="flex items-center justify-between gap-2">
				<!-- Display Mode Toggle (List / Grid without check icon) -->
				<div class="flex" role="group" aria-label="チェックリストの表示形式">
					<div class="inline-flex items-center rounded-lg border border-gray-300 bg-white p-0.5 shadow-sm">
						<button
							type="button"
							data-display-mode-option="headline_view"
							aria-label="リスト表示"
							aria-pressed={initialDisplayMode === "headline_view" ? "true" : "false"}
							class={`flex h-7 w-8 items-center justify-center transition-colors hover:text-mint-600 active:scale-95 ${initialDisplayMode === "headline_view" ? "text-mint-600" : "text-gray-400"}`}
						>
							<span class="material-symbols-outlined text-[1.2rem]" aria-hidden="true">view_headline</span>
						</button>
						<button
							type="button"
							data-display-mode-option="grid_view"
							aria-label="画像表示"
							aria-pressed={initialDisplayMode === "grid_view" ? "true" : "false"}
							class={`flex h-7 w-8 items-center justify-center transition-colors hover:text-mint-600 active:scale-95 ${initialDisplayMode === "grid_view" ? "text-mint-600" : "text-gray-400"}`}
						>
							<span class="material-symbols-outlined text-[1.2rem]" aria-hidden="true">grid_view</span>
						</button>
					</div>
				</div>

				<!-- Filter & Sort Modal Triggers -->
				<div class="flex items-center gap-2">
					<button
						type="button"
						id="open-filter-sheet-btn"
						class="inline-flex items-center gap-1.5 rounded-xl border border-gray-300 bg-white px-3.5 py-2 text-xs font-bold text-gray-700 transition-colors hover:bg-gray-50 active:scale-95 shadow-sm"
					>
						<span class="material-symbols-outlined text-base">filter_alt</span>
						<span>絞り込み</span>
					</button>
					<button
						type="button"
						id="open-sort-sheet-btn"
						class="inline-flex items-center gap-1.5 rounded-xl border border-gray-300 bg-white px-3.5 py-2 text-xs font-bold text-gray-700 transition-colors hover:bg-gray-50 active:scale-95 shadow-sm"
					>
						<span class="material-symbols-outlined text-base">swap_vert</span>
						<span>並び替え</span>
					</button>
				</div>
			</div>

			<!-- Applied Active Filter Chips -->
			<div id="active-chips-container" class="flex flex-wrap gap-2 pt-0.5 hidden">
				<!-- Dynamically generated active chips -->
			</div>

		</div>

		<!-- Feed Container -->
		<div
			class="flex flex-col gap-10"
			id="knowhow-container"
			data-display-mode={initialDisplayMode}
			data-list-view={isMyListPage ? "my" : "discover"}
			data-private-state-loaded={isMyListPage ? "false" : "true"}
			data-filter-options={JSON.stringify(filterOptions)}
		>
			{
				knowhow.map(
					(post) => (
						<article
							class="knowhow-card bg-white lg:border border-gray-200 lg:shadow-sm overflow-hidden"
							data-phases={post.data.phases.join(",")}
							data-scenes={post.data.scenes.join(",")}
							data-timeline-order={post.data.timelineOrder}
							data-id={post.id}
							data-checklist-id={post.data.checklistId}
						>
							<div data-my-list-swipe-row class="relative">
								<button
									type="button"
									data-my-list-delete
									aria-label={`${post.data.title}をマイリストから削除`}
									class="my-list-delete-action" hidden
								>
									<span class="material-symbols-outlined text-2xl" aria-hidden="true">delete</span>
									<span>削除</span>
								</button>

								<div data-my-list-swipe-content class="relative z-10 bg-white transition-transform duration-200">
									<div
										class="knowhow-gallery-view relative overflow-hidden bg-black cursor-default group shadow-sm"
										data-open-checklist={post.id}
										role="button"
										tabindex="0"
										aria-label={post.data.title + "を開く"}
									>
										<!-- Main Image -->
										<div class="w-full aspect-[4/5] bg-gray-900 flex items-center justify-center overflow-hidden">
											{post.data.coverImage ? (
														<img src={post.data.coverImage} alt={post.data.title} draggable="false" class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-105" />
											) : (
												<div class="w-full h-full flex items-center justify-center">
													<span class="material-symbols-outlined text-gray-600 text-5xl">image</span>
												</div>
											)}
										</div>

										<!-- Image Bottom Overlay (Smooth Gradient) -->
										<div class="absolute inset-x-0 bottom-0 pt-10 pb-3 px-3.5 bg-gradient-to-t from-black/85 via-black/40 to-transparent flex items-end justify-between text-white pointer-events-none">
											<span class="truncate mr-2 text-[0.85rem] font-bold text-white drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)]">{post.data.title}</span>
											<div class="pointer-events-auto text-white">
												<LikeButton slug={`knowhow/${post.id}`} variant="compact" startOnLike={true} />
											</div>
										</div>
									</div>
									
									<div
										class="knowhow-list-view w-full text-left transition-colors hover:bg-gray-50 active:bg-gray-100"
										data-open-checklist={post.id}
										role="button"
										tabindex="0"
										aria-label={post.data.title + "を開く"}
									>
										<div class="min-w-0 flex-1 px-4 py-4">
											<div class="flex items-start justify-between gap-2">
												<h2 class="text-[0.95rem] font-bold leading-snug text-navy-900 flex-1">{post.data.title}</h2>
												<div class="pointer-events-auto shrink-0">
													<LikeButton slug={`knowhow/${post.id}`} variant="compact" startOnLike={true} />
												</div>
											</div>
										<p class="knowhow-summary mt-2 line-clamp-2 text-[0.8rem] leading-relaxed text-gray-600" set:text={post.data.description}></p>
										</div>
										<div class="flex h-[104px] w-[120px] shrink-0 items-center justify-center overflow-hidden border-l border-gray-100 bg-gray-50">
											{post.data.coverImage ? (
														<img src={post.data.coverImage} alt="" draggable="false" class="h-full w-full object-cover object-top" />
											) : (
												<span class="material-symbols-outlined text-4xl text-gray-300" aria-hidden="true">image</span>
											)}
										</div>
									</div>
								</div>
							</div>
						</article>
					),
				)
			}
		</div>
		<div id="knowhow-empty" class="hidden rounded-xl border border-gray-200 bg-white px-6 py-10 text-center">
			<span class="material-symbols-outlined text-4xl text-gray-300" aria-hidden="true">checklist</span>
			<p data-empty-message class="mt-3 text-sm font-bold text-gray-700">まだ始めたチェックリストはありません。</p>
			<a href="/" class="mt-4 inline-block text-sm font-bold text-mint-600 hover:text-mint-700">
				チェックリストを探す
			</a>
		</div>
	</div>

	<!-- Filter Sheet Modal -->
	<dialog data-list-sheet id="filter-sheet-modal" class="fixed inset-0 z-[100] m-0 h-full max-h-none w-full max-w-none items-end bg-black/50 p-0 border-none outline-none backdrop-blur-sm overflow-hidden">
		<div data-list-sheet-content id="filter-sheet-content" class="w-full max-w-lg mx-auto rounded-t-3xl bg-white px-6 pb-6 pt-3 h-[80vh] max-h-[80vh] overflow-y-auto scrollbar-hide flex flex-col gap-5 border border-gray-200">
			<!-- Handle Bar -->
			<div data-list-sheet-handle class="w-10 h-1 bg-gray-300 rounded-full mx-auto shrink-0" id="close-sheet-handle"></div>

			<!-- 1. 月齢 -->
			<div>
				<h3 class="font-bold text-gray-900 text-base mb-3">月齢</h3>
				<div class="flex flex-wrap gap-2.5" id="sheet-phase-group">
					{phases.map((phase) => (
						<button
							type="button"
							data-sheet-phase={phase.id}
							class="sheet-phase-btn rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-all hover:bg-gray-50"
						>
							{phase.label}
						</button>
					))}
				</div>
			</div>

			<!-- 2. カテゴリ -->
			<div>
				<h3 class="font-bold text-gray-900 text-base mb-3">カテゴリ</h3>
				<div class="flex flex-wrap gap-2.5" id="sheet-scene-group">
					{scenes.map((scene) => (
						<button
							type="button"
							data-sheet-scene={scene.label}
							class="sheet-scene-btn rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-all hover:bg-gray-50"
						>
							{scene.label}
						</button>
					))}
				</div>
			</div>

			<!-- 3. 表示条件 -->
			<div>
				<h3 class="font-bold text-gray-900 text-base mb-3">表示条件</h3>
				<label class="flex items-center gap-2 text-sm cursor-pointer font-medium text-gray-700">
					<input type="checkbox" id="sheet-fav-only" class="w-4 h-4 rounded text-mint-600 border-gray-300 focus:ring-mint-500" />
					<span>お気に入りのみ表示</span>
				</label>
			</div>

			<div id="sheet-deleted-only-row" class="hidden">
				<label class="flex items-center gap-2 text-sm cursor-pointer font-medium text-gray-700">
					<input type="checkbox" id="sheet-deleted-only" class="w-4 h-4 rounded text-red-600 border-gray-300 focus:ring-red-500" />
					<span>削除済み表示</span>
				</label>
			</div>

			<!-- Footer Action Buttons -->
			<div class="flex items-center gap-3 pt-2 shrink-0 mt-auto">
				<button type="button" id="sheet-reset-btn" class="flex-1 rounded-xl border border-mint-600 bg-white py-3.5 text-center text-sm font-bold text-mint-600 transition-colors hover:bg-mint-50">リセット</button>
				<button type="button" id="sheet-apply-btn" class="flex-1 rounded-xl bg-mint-600 py-3.5 text-center text-sm font-bold text-white shadow-md transition-colors hover:bg-mint-700">絞り込み</button>
			</div>
		</div>
	</dialog>

	<!-- Sort Sheet Modal -->
	<dialog data-list-sheet id="sort-sheet-modal" class="fixed inset-0 z-[100] m-0 h-full max-h-none w-full max-w-none items-end bg-black/50 p-0 border-none outline-none backdrop-blur-sm overflow-hidden">
		<div data-list-sheet-content id="sort-sheet-content" class="w-full max-w-lg mx-auto rounded-t-3xl bg-white px-6 pb-6 pt-3 h-[80vh] max-h-[80vh] overflow-y-auto scrollbar-hide flex flex-col gap-5 border border-gray-200">
			<!-- Handle Bar -->
			<div data-list-sheet-handle class="w-10 h-1 bg-gray-300 rounded-full mx-auto shrink-0" id="close-sort-sheet-handle"></div>

			<div>
				<h3 class="font-bold text-gray-900 text-base mb-3">並び替え</h3>
				<div class="flex flex-col gap-2 text-sm">
					<label class="flex items-center gap-3 cursor-pointer rounded-xl border border-gray-200 px-4 py-3 font-medium text-gray-700 transition-colors hover:bg-gray-50">
						<input type="radio" name="sheet-sort" value="recommend" checked class="w-4 h-4 text-mint-600 border-gray-300 focus:ring-mint-500" />
						<span>おすすめ順</span>
					</label>
					<label class="flex items-center gap-3 cursor-pointer rounded-xl border border-gray-200 px-4 py-3 font-medium text-gray-700 transition-colors hover:bg-gray-50">
						<input type="radio" name="sheet-sort" value="newest" class="w-4 h-4 text-mint-600 border-gray-300 focus:ring-mint-500" />
						<span>新着順</span>
					</label>
					<label class="flex items-center gap-3 cursor-pointer rounded-xl border border-gray-200 px-4 py-3 font-medium text-gray-700 transition-colors hover:bg-gray-50">
						<input type="radio" name="sheet-sort" value="popular" class="w-4 h-4 text-mint-600 border-gray-300 focus:ring-mint-500" />
						<span>人気順</span>
					</label>
				</div>
			</div>

			<div class="flex items-center gap-3 pt-2 shrink-0 mt-auto">
				<button type="button" id="sort-sheet-reset-btn" class="flex-1 rounded-xl border border-mint-600 bg-white py-3.5 text-center text-sm font-bold text-mint-600 transition-colors hover:bg-mint-50">リセット</button>
				<button type="button" id="sort-sheet-apply-btn" class="flex-1 rounded-xl bg-mint-600 py-3.5 text-center text-sm font-bold text-white shadow-md transition-colors hover:bg-mint-700">並び替える</button>
			</div>
		</div>
	</dialog>

</Layout>

<script>
	import { navigate } from 'astro:transitions/client';
	import {
		getPrivateSetting,
		getPrivateChecklistRuns,
		initializePrivateDb,
		setPrivateSetting,
	} from '../scripts/private-db';
	import { getBatchArticleLikeStates } from '../scripts/article-likes';
	import {
		bindPrivateListSwipeRows,
	} from '../scripts/private-list-delete';
	import { createListSheetController } from '../scripts/list-page';
	import {
		readKnowhowListCache,
		saveKnowhowListCache,
		type KnowhowListSort,
	} from '../scripts/knowhow-list-cache';

	type DisplayMode = 'headline_view' | 'grid_view';
	const DISPLAY_MODE_SETTING_KEY = 'knowhow-display-mode';

	declare global {
		interface Window {
			openModal?: (id: string, options?: { start?: boolean; skipLike?: boolean }) => void;
		}
	}

	document.addEventListener('astro:page-load', () => {
		const knowhowContainer = document.getElementById('knowhow-container');
		if (!knowhowContainer || knowhowContainer.dataset.knowhowListInitialized === 'true') return;
		knowhowContainer.dataset.knowhowListInitialized = 'true';
		const listeners = new AbortController();
		const listenerOptions = { signal: listeners.signal };
		let destroyed = false;

		let isNavigating = false;
		const openChecklist = async (id: string, options?: { start?: boolean; skipLike?: boolean }) => {
			if (destroyed || isNavigating) return;
			isNavigating = true;
			try {
				try {
					sessionStorage.setItem('knowhow:return-url', window.location.pathname + window.location.search);
					if (options?.start) {
						sessionStorage.setItem('knowhow:start-after-open', id);
						sessionStorage.setItem('knowhow:start-after-open-skip-like', String(options.skipLike === true));
					}
				} catch {
					// Session storage may be unavailable in strict privacy modes.
				}
				const checklistId = cardsById.get(id)?.dataset.checklistId;
				persistListState();
				const isPrivateListItem = currentListView === 'my'
					&& (Boolean(checklistId && startedChecklistIds.has(checklistId)) || isDeletedOnly);
				const destination = isPrivateListItem
					? `/my-knowhow/${id}/`
					: `/knowhow/${id}/`;
				await navigate(destination);
			} finally {
				isNavigating = false;
			}
		};
		window.openModal = openChecklist;

		const startRequestHandler = (event: Event) => {
			const detail = (event as CustomEvent<{ slug?: string; skipLike?: boolean }>).detail;
			const id = detail?.slug?.startsWith('knowhow/') ? detail.slug.slice('knowhow/'.length) : '';
			if (id) void openChecklist(id, { start: true, skipLike: detail.skipLike === true });
		};
		window.addEventListener('checklist-start-requested', startRequestHandler, listenerOptions);

		type FilterOption = { id: string; label: string };
		type SceneOption = { label: string };
		type PhaseFilter = string;
		type SceneFilter = string;

		const PHASE_SETTING_KEY = 'knowhow-selected-phase';
		const filterOptionsFallback = {
			phases: [],
			scenes: [],
		};
		const filterOptions = (() => {
			try {
				return JSON.parse(knowhowContainer?.dataset.filterOptions ?? JSON.stringify(filterOptionsFallback)) as {
					phases?: FilterOption[];
					scenes?: SceneOption[];
				};
			} catch {
				return filterOptionsFallback;
			}
		})();
		const filterPhaseOptions = filterOptions.phases ?? filterOptionsFallback.phases;
		const filterSceneOptions = filterOptions.scenes ?? [];
		const validPhases = new Set<PhaseFilter>(filterPhaseOptions.map((phase) => phase.id));
		const validScenes = new Set<SceneFilter>(filterSceneOptions.map((scene) => scene.label));
		const sceneSlugByLabel: Record<string, string> = {
			'おでかけ': 'outing',
			'病院・健診': 'medical',
			'毎日の準備': 'daily',
			'帰省・旅行': 'travel',
			'保育園': 'nursery',
			'防災': 'disaster',
		};
		const sceneLabelBySlug = new Map<string, SceneFilter>(
			Object.entries(sceneSlugByLabel)
				.map(([label, slug]) => [slug, label]),
		);
		filterSceneOptions.forEach((scene) => {
			sceneLabelBySlug.set(scene.label, scene.label);
			sceneLabelBySlug.set(encodeURIComponent(scene.label), scene.label);
		});
		const cards = Array.from(document.querySelectorAll<HTMLElement>('.knowhow-card'));
		const cardsById = new Map(cards.map((card) => [card.dataset.id ?? '', card]));
		const displayModeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-display-mode-option]'));
		const emptyState = document.getElementById('knowhow-empty');
		const emptyMessage = emptyState?.querySelector<HTMLElement>('[data-empty-message]');

		const getModeFromUrl = (): DisplayMode | null => {
			const params = new URLSearchParams(window.location.search);
			const mode = params.get('mode') || params.get('view_mode');
			if (mode === 'grid_view' || mode === 'grid' || mode === 'gallery') return 'grid_view';
			if (mode === 'headline_view' || mode === 'headline' || mode === 'list') return 'headline_view';
			return null;
		};

		const readListRoute = () => {
			const params = new URLSearchParams(window.location.search);
			const segments = window.location.pathname.split('/').filter(Boolean);
			const privateIndex = segments.indexOf('my-knowhow');
			const publicIndex = segments.indexOf('knowhow');
			const view: 'discover' | 'my' = privateIndex >= 0 ? 'my' : 'discover';
			const baseIndex = view === 'my' ? privateIndex : publicIndex;
			const routeSegments = baseIndex >= 0 ? segments.slice(baseIndex + 1) : [];

			let pathPhases: PhaseFilter[] = [];
			let pathScene: SceneFilter = 'all';
			if (routeSegments[0] === 'phase' && validPhases.has(routeSegments[1] as PhaseFilter)) {
				pathPhases = [routeSegments[1] as PhaseFilter];
				if (routeSegments[2] === 'scene') {
					pathScene = sceneLabelBySlug.get(routeSegments[3] ?? '') ?? 'all';
				}
			} else if (routeSegments[0] === 'scene') {
				pathScene = sceneLabelBySlug.get(routeSegments[1] ?? '') ?? 'all';
			}

			const queryPhases = params.getAll('phase')
				.flatMap((value) => value.split(','))
				.filter((phase): phase is PhaseFilter => validPhases.has(phase));
			const queryScene = params.get('scene');
			const parsedQueryScene = queryScene
				? sceneLabelBySlug.get(queryScene) ?? (validScenes.has(queryScene as SceneFilter) ? queryScene as SceneFilter : 'all')
				: 'all';
			const phasesFromRoute = Array.from(new Set(queryPhases.length > 0 ? queryPhases : pathPhases));
			const scene = parsedQueryScene !== 'all' ? parsedQueryScene : pathScene;
			return {
				view,
				phases: phasesFromRoute,
				scene,
				hasPhase: phasesFromRoute.length > 0,
				deletedOnly: view === 'my' && ['1', 'true'].includes(params.get('deleted') ?? ''),
			};
		};

		const initialRoute = readListRoute();
		const initialModeFromUrl = getModeFromUrl();
		let currentListView: 'discover' | 'my' = initialRoute.view;
		const hasInitialDeletedOnly = initialRoute.deletedOnly;
		let currentPhases = new Set<PhaseFilter>(initialRoute.phases);
		const hasInitialPhase = initialRoute.hasPhase;
		let currentScene: SceneFilter = initialRoute.scene;
		let currentDisplayMode: DisplayMode = initialModeFromUrl || 'headline_view';
		let startedChecklistIds = new Set<string>();
		let deletedChecklistIds = new Set<string>();
		let userLikedSlugs = new Set<string>();
		const userLikeOverrides = new Map<string, { isLiked: boolean; likeCount: number }>();
		let isPrivateDbLoaded = false;
		let visibleListIds: string[] = [];

		function persistListState(orderedIds = visibleListIds) {
			if (currentListView !== 'my' || !isPrivateDbLoaded) return;
			saveKnowhowListCache({
				sourcePath: window.location.pathname + window.location.search,
				view: currentListView,
				displayMode: currentDisplayMode,
				phases: Array.from(currentPhases),
				scene: currentScene,
				favoriteOnly: isFavOnly,
				deletedDisplay: isDeletedOnly,
				searchKeyword: searchKeyword.trim(),
				sort: currentSort,
				orderedIds: orderedIds.filter(Boolean),
			});
		}

		function updateUrl(pushHistory = false) {
			const params = new URLSearchParams(window.location.search);
			params.delete('phase');
			currentPhases.forEach((phase) => params.append('phase', phase));

			if (currentScene !== 'all') params.set('scene', currentScene);
			else params.delete('scene');

			if (currentDisplayMode === 'grid_view') {
				params.set('mode', 'grid_view');
				params.delete('view_mode');
			} else {
				params.set('mode', 'headline_view');
				params.delete('view_mode');
			}

			if (currentListView === 'my' && isDeletedOnly) params.set('deleted', '1');
			else params.delete('deleted');

			const queryString = params.toString();
			const newPath = window.location.pathname + (queryString ? `?${queryString}` : '');
			
			const state = { knowhowView: currentListView, phases: Array.from(currentPhases), scene: currentScene, displayMode: currentDisplayMode };
			if (pushHistory) history.pushState(state, '', newPath);
			else history.replaceState(state, '', newPath);
			persistListState();
		}

		const ACTIVE_MODE_CLASSES = ['text-mint-600'];
		const INACTIVE_MODE_CLASSES = ['text-gray-400'];

		function refreshDisplayMode() {
			if (knowhowContainer) knowhowContainer.dataset.displayMode = currentDisplayMode;
			document.documentElement.dataset.knowhowInitialDisplayMode = currentDisplayMode;
			for (const button of displayModeButtons) {
				const active = button.dataset.displayModeOption === currentDisplayMode;
				button.setAttribute('aria-pressed', String(active));
				ACTIVE_MODE_CLASSES.forEach((cls) => button.classList.toggle(cls, active));
				INACTIVE_MODE_CLASSES.forEach((cls) => button.classList.toggle(cls, !active));
			}
		}

		function setDisplayMode(mode: DisplayMode, pushHistory = true, persist = true) {
			currentDisplayMode = mode;
			refreshDisplayMode();
			updateView();
			updateUrl(pushHistory);
			if (persist) void setPrivateSetting(DISPLAY_MODE_SETTING_KEY, mode).catch(() => undefined);
		}

		function setPhases(phases: Iterable<PhaseFilter>, pushHistory = true, persist = true) {
			currentPhases = new Set(phases);
			updateView();
			updateUrl(pushHistory);
			if (persist) void setPrivateSetting(PHASE_SETTING_KEY, Array.from(currentPhases)).catch(() => undefined);
		}

		function setScene(scene: string, pushHistory = true) {
			currentScene = scene;
			updateView();
			updateUrl(pushHistory);
		}

		function syncListViewFromUrl() {
			const route = readListRoute();
			currentListView = route.view;
			currentPhases = new Set(route.phases);
			currentScene = route.scene;
			isDeletedOnly = route.deletedOnly;
			restoreCachedTransientState();
			const urlMode = getModeFromUrl();
			if (urlMode) {
				currentDisplayMode = urlMode;
				refreshDisplayMode();
			}
			updateView();
		}
		window.addEventListener('popstate', syncListViewFromUrl, listenerOptions);

// Filter Sheet, Sort Sheet, and active state logic
		const openFilterBtn = document.getElementById('open-filter-sheet-btn');
		const openSortBtn = document.getElementById('open-sort-sheet-btn');
		const filterSheetModal = document.getElementById('filter-sheet-modal') as HTMLDialogElement | null;
		const sortSheetModal = document.getElementById('sort-sheet-modal') as HTMLDialogElement | null;
		const filterSheetResetBtn = document.getElementById('sheet-reset-btn');
		const filterSheetApplyBtn = document.getElementById('sheet-apply-btn');
		const sortSheetResetBtn = document.getElementById('sort-sheet-reset-btn');
		const sortSheetApplyBtn = document.getElementById('sort-sheet-apply-btn');
		const sheetFavOnlyCheckbox = document.getElementById('sheet-fav-only') as HTMLInputElement | null;
		const sheetDeletedOnlyRow = document.getElementById('sheet-deleted-only-row');
		const sheetDeletedOnlyCheckbox = document.getElementById('sheet-deleted-only') as HTMLInputElement | null;
		const searchInput = document.getElementById('search-keyword-input') as HTMLInputElement | null;
		const activeChipsContainer = document.getElementById('active-chips-container');
		const sheetPhaseButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sheet-phase]'));
		const sheetSceneButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sheet-scene]'));
		const sheetSortRadios = Array.from(
			sortSheetModal?.querySelectorAll<HTMLInputElement>('input[name="sheet-sort"]') ?? [],
		);

		type SortOption = KnowhowListSort;
		let currentSort: SortOption = 'recommend';
		let searchKeyword = '';
		let isFavOnly = false;
		let isDeletedOnly = hasInitialDeletedOnly;

		const restoreCachedTransientState = () => {
			if (currentListView !== 'my') return;
			const cached = readKnowhowListCache();
			const currentPath = window.location.pathname + window.location.search;
			if (!cached || cached.view !== 'my' || cached.sourcePath !== currentPath) return;
			isFavOnly = cached.favoriteOnly;
			searchKeyword = cached.searchKeyword;
			currentSort = cached.sort;
			if (searchInput) searchInput.value = searchKeyword;
		};
		restoreCachedTransientState();

		const ACTIVE_THEME_CLASSES = ['text-mint-600'];
		const INACTIVE_THEME_CLASSES = ['text-gray-700'];

		const updateButtonActiveStates = () => {
			const isFilterActive = currentPhases.size > 0 || currentScene !== 'all' || isFavOnly || isDeletedOnly || searchKeyword.trim() !== '';
			ACTIVE_THEME_CLASSES.forEach((cls) => openFilterBtn?.classList.toggle(cls, isFilterActive));
			INACTIVE_THEME_CLASSES.forEach((cls) => openFilterBtn?.classList.toggle(cls, !isFilterActive));

			const isSortActive = currentSort !== 'recommend';
			ACTIVE_THEME_CLASSES.forEach((cls) => openSortBtn?.classList.toggle(cls, isSortActive));
			INACTIVE_THEME_CLASSES.forEach((cls) => openSortBtn?.classList.toggle(cls, !isSortActive));
		};

		const filterSheetController = createListSheetController(filterSheetModal);
		const sortSheetController = createListSheetController(sortSheetModal);

		const closeSheetModal = (modal: HTMLDialogElement | null) => {
			(modal === sortSheetModal ? sortSheetController : filterSheetController)?.close();
		};

		const openSheetModal = (targetSection: 'filter' | 'sort' = 'filter') => {
			const controller = targetSection === 'sort' ? sortSheetController : filterSheetController;
			const otherController = targetSection === 'sort' ? filterSheetController : sortSheetController;
			otherController?.close();
			updateSheetUi();
			controller?.open();
		};

		openFilterBtn?.addEventListener('click', () => openSheetModal('filter'), listenerOptions);
		openSortBtn?.addEventListener('click', () => openSheetModal('sort'), listenerOptions);
		function updateSheetUi() {
			sheetPhaseButtons.forEach((btn) => {
				const phase = btn.dataset.sheetPhase as PhaseFilter;
				const active = currentPhases.has(phase);
				btn.classList.toggle('bg-mint-600', active);
				btn.classList.toggle('text-white', active);
				btn.classList.toggle('font-bold', active);
				btn.classList.toggle('bg-white', !active);
				btn.classList.toggle('text-gray-700', !active);
				btn.classList.toggle('border-gray-200', !active);
			});

			sheetSceneButtons.forEach((btn) => {
				const scene = btn.dataset.sheetScene as SceneFilter;
				const active = scene === currentScene;
				btn.classList.toggle('bg-mint-600', active);
				btn.classList.toggle('text-white', active);
				btn.classList.toggle('font-bold', active);
				btn.classList.toggle('bg-white', !active);
				btn.classList.toggle('text-gray-700', !active);
				btn.classList.toggle('border-gray-200', !active);
			});

			sheetSortRadios.forEach((radio) => {
				radio.checked = radio.value === currentSort;
			});

			if (sheetFavOnlyCheckbox && !filterSheetModal?.open) sheetFavOnlyCheckbox.checked = isFavOnly;
			sheetDeletedOnlyRow?.classList.toggle('hidden', currentListView !== 'my');
			// 非同期のIndexedDB更新で一覧を再描画しても、開いているシート内の
			// ユーザー選択を上書きしない。開く瞬間は上のopenSheetModalで同期する。
			if (sheetDeletedOnlyCheckbox && !filterSheetModal?.open) sheetDeletedOnlyCheckbox.checked = isDeletedOnly;
		}

		function renderActiveChips() {
			if (!activeChipsContainer) return;
			activeChipsContainer.replaceChildren();

			const chips: { label: string; onRemove: () => void }[] = [];

			for (const phase of currentPhases) {
				const phaseLabel = filterPhaseOptions.find((option) => option.id === phase)?.label ?? phase;
				chips.push({
					label: phaseLabel,
					onRemove: () => {
						const nextPhases = new Set(currentPhases);
						nextPhases.delete(phase);
						setPhases(nextPhases);
					},
				});
			}

			if (currentScene !== 'all') {
				chips.push({
					label: currentScene,
					onRemove: () => { setScene('all'); },
				});
			}

			if (searchKeyword) {
				chips.push({
					label: `検索: "${searchKeyword}"`,
					onRemove: () => {
						searchKeyword = '';
						if (searchInput) searchInput.value = '';
						updateView();
					},
				});
			}

			if (isFavOnly && currentListView !== 'my') {
				chips.push({
					label: 'お気に入りのみ',
					onRemove: () => { isFavOnly = false; updateView(); },
				});
			}

			if (isDeletedOnly && currentListView === 'my') {
				chips.push({
					label: '削除済み表示',
					onRemove: () => { isDeletedOnly = false; updateUrl(true); updateView(); },
				});
			}

			if (currentSort !== 'recommend') {
				const sortLabel = currentSort === 'newest' ? '新着順' : '人気順';
				chips.push({
					label: sortLabel,
					onRemove: () => { currentSort = 'recommend'; updateView(); },
				});
			}

			if (chips.length === 0) {
				activeChipsContainer.classList.add('hidden');
			} else {
				activeChipsContainer.classList.remove('hidden');
				chips.forEach(({ label, onRemove }) => {
					const chip = document.createElement('button');
					chip.type = 'button';
					chip.className = 'inline-flex items-center gap-1 bg-mint-50 text-mint-600 border border-mint-200 rounded-full px-3 py-1 text-xs font-bold transition-all hover:bg-mint-100 active:scale-95';
					chip.innerHTML = `<span>${label}</span><span class="material-symbols-outlined text-sm">close</span>`;
					chip.addEventListener('click', onRemove, listenerOptions);
					activeChipsContainer.appendChild(chip);
				});
			}
		}

		knowhowContainer?.addEventListener('click', (event) => {
			const target = event.target as HTMLElement;
			if (target.closest('.like-btn')) return;
			const openButton = target.closest<HTMLElement>('[data-open-checklist]');
			if (openButton?.dataset.openChecklist) {
				void openChecklist(openButton.dataset.openChecklist);
			}
		}, listenerOptions);

		knowhowContainer?.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			const target = event.target as HTMLElement;
			if (target.closest('.like-btn')) return;
			const openButton = target.closest<HTMLElement>('[data-open-checklist]');
			if (!openButton?.dataset.openChecklist) return;
			event.preventDefault();
			void openChecklist(openButton.dataset.openChecklist);
		}, listenerOptions);

		const swipeRows = Array.from(document.querySelectorAll<HTMLElement>('[data-my-list-swipe-row]'));

		const canDeleteRow = (row: HTMLElement) => {
			if (!isPrivateDbLoaded || currentDisplayMode !== 'headline_view') return false;
			const checklistId = row.closest<HTMLElement>('.knowhow-card')?.dataset.checklistId;
			return Boolean(checklistId && startedChecklistIds.has(checklistId));
		};

		let swipeController: ReturnType<typeof bindPrivateListSwipeRows> | null = null;
		const updateSwipeRows = () => {
			const shouldBind = currentDisplayMode === 'headline_view';
			if (shouldBind && !swipeController) {
				swipeController = bindPrivateListSwipeRows({
					rows: swipeRows,
					canDelete: canDeleteRow,
					onDeleted: () => refreshFromSavedRuns(),
				});
			} else if (!shouldBind && swipeController) {
				swipeController.destroy();
				swipeController = null;
			}
			swipeController?.refresh();
		};

		function updateView() {
			if (currentListView === 'my' && !isPrivateDbLoaded) {
				cards.forEach(card => card.style.display = 'none');
				if (emptyState) emptyState.classList.add('hidden');
				updateSwipeRows();
				return;
			}

			updateButtonActiveStates();
			updateSheetUi();
			renderActiveChips();

			const keywordLower = searchKeyword.trim().toLowerCase();

	
			cards.forEach((card) => {
				const cardPhases = (card.dataset.phases || '').split(',');
				const cardScenes = (card.dataset.scenes || '').split(',');
				
				const phaseMatch = currentPhases.size === 0 || cardPhases.some((phase) => currentPhases.has(phase));
				const sceneMatch = currentScene === 'all' || cardScenes.includes(currentScene);
				const checklistId = card.dataset.checklistId;
				const cardId = card.dataset.id;
				const title = card.querySelector('h2, h3')?.textContent?.toLowerCase() || '';
				const desc = card.querySelector('.knowhow-summary')?.textContent?.toLowerCase() || '';

				const activeMatch = Boolean(checklistId && startedChecklistIds.has(checklistId));
				const deletedMatch = Boolean(checklistId && deletedChecklistIds.has(checklistId) && !startedChecklistIds.has(checklistId));
				const favoriteMatch = Boolean(cardId && userLikedSlugs.has(`knowhow/${cardId}`));
				let viewMatch = true;
				if (currentListView === 'discover') {
					viewMatch = !isFavOnly || favoriteMatch;
				} else if (!isFavOnly && !isDeletedOnly) {
					viewMatch = activeMatch;
				} else {
					// マイリストの表示条件はANDではなく、選択された条件のORで評価する。
					const favoriteSelection = isFavOnly && activeMatch && favoriteMatch;
					const deletedSelection = isDeletedOnly && (activeMatch || deletedMatch);
					viewMatch = favoriteSelection || deletedSelection;
				}

				let searchMatch = true;
				if (keywordLower) {
					searchMatch = title.includes(keywordLower) || desc.includes(keywordLower);
				}


				card.style.display = phaseMatch && sceneMatch && viewMatch && searchMatch ? 'block' : 'none';
			});

			const visibleCards = cards.filter((card) => card.style.display !== 'none');
				
			visibleCards
				.sort((a, b) => {
					if (currentSort === 'newest') {
						const dateA = Number(a.dataset.pubdate || 0);
						const dateB = Number(b.dataset.pubdate || 0);
						return dateB - dateA;
					}
					if (currentSort === 'popular') {
						const likesA = Number(a.dataset.likes || 0);
						const likesB = Number(b.dataset.likes || 0);
						return likesB - likesA;
					}
					return Number(a.dataset.timelineOrder ?? 0) - Number(b.dataset.timelineOrder ?? 0);
				})
				.forEach((card, index) => {
					card.style.setProperty('order', String(index));
				});
			visibleListIds = visibleCards
				.map((card) => card.dataset.id ?? '')
				.filter(Boolean);
			persistListState(visibleListIds);

			if (emptyState) {
				if (visibleCards.length === 0) {
					emptyState.classList.remove('hidden');
					if (emptyMessage) {
						if (currentListView === 'my') emptyMessage.textContent = isDeletedOnly ? '表示できるチェックリストはありません。' : 'まだ始めたチェックリストはありません。';
						else emptyMessage.textContent = '条件に一致するチェックリストが見つかりませんでした。';
					}
				} else {
					emptyState.classList.add('hidden');
				}
			}
			updateSwipeRows();
		}

		sheetPhaseButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const phase = btn.dataset.sheetPhase as PhaseFilter;
				const nextPhases = new Set(currentPhases);
				if (nextPhases.has(phase)) nextPhases.delete(phase);
				else nextPhases.add(phase);
				setPhases(nextPhases);
				updateSheetUi();
			}, listenerOptions);
		});

		sheetSceneButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const scene = btn.dataset.sheetScene as SceneFilter;
				setScene(currentScene === scene ? 'all' : scene);
				updateSheetUi();
			}, listenerOptions);
		});

		filterSheetResetBtn?.addEventListener('click', () => {
			isFavOnly = false;
			isDeletedOnly = false;
			searchKeyword = '';
			if (searchInput) searchInput.value = '';
			setPhases([]);
			setScene('all');
			closeSheetModal(filterSheetModal);
		}, listenerOptions);

		filterSheetApplyBtn?.addEventListener('click', () => {
			if (sheetFavOnlyCheckbox) isFavOnly = sheetFavOnlyCheckbox.checked;
			isDeletedOnly = currentListView === 'my' && Boolean(sheetDeletedOnlyCheckbox?.checked);
			updateUrl(true);
			updateView();
			closeSheetModal(filterSheetModal);
		}, listenerOptions);

		sortSheetResetBtn?.addEventListener('click', () => {
			currentSort = 'recommend';
			updateUrl(true);
			updateView();
			closeSheetModal(sortSheetModal);
		}, listenerOptions);

		sortSheetApplyBtn?.addEventListener('click', () => {
			const selectedRadio = sheetSortRadios.find((radio) => radio.checked);
			if (selectedRadio) currentSort = selectedRadio.value as SortOption;
			updateUrl(true);
			updateView();
			closeSheetModal(sortSheetModal);
		}, listenerOptions);
		let searchDebounce: number | undefined;
		searchInput?.addEventListener('input', () => {
			window.clearTimeout(searchDebounce);
			searchDebounce = window.setTimeout(() => {
				searchKeyword = searchInput.value;
				updateView();
			}, 250);
		}, listenerOptions);

		displayModeButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const mode = button.dataset.displayModeOption as DisplayMode;
				if (mode === 'grid_view' || mode === 'headline_view') setDisplayMode(mode, true);
			}, listenerOptions);
		});
		const refreshFromSavedRuns = async () => {
			const runs = await getPrivateChecklistRuns();
			if (destroyed) return;
			startedChecklistIds = new Set(runs.filter((run) => !run.deletedAt).map((run) => run.checklistId));
			deletedChecklistIds = new Set(runs.filter((run) => Boolean(run.deletedAt)).map((run) => run.checklistId));
			isPrivateDbLoaded = true;
			knowhowContainer.dataset.privateStateLoaded = 'true';
			updateView();
		};
		window.addEventListener('checklist-runs-changed', () => void refreshFromSavedRuns(), listenerOptions);

		const applyLikeState = (slug: string, isLiked: boolean, likeCount: number) => {
			if (isLiked) userLikedSlugs.add(slug);
			else userLikedSlugs.delete(slug);

			const id = slug.replace('knowhow/', '');
			const card = cardsById.get(id);
			if (card) card.dataset.likes = String(likeCount);

			knowhowContainer.querySelectorAll<HTMLElement>(`[data-like-count-for="${id}"]`).forEach((count) => {
				count.textContent = String(likeCount);
			});
			knowhowContainer.querySelectorAll<HTMLElement>(`[data-like-icon-for="${id}"]`).forEach((icon) => {
				icon.classList.toggle('text-pink-500', isLiked);
				icon.style.fontVariationSettings = isLiked ? "'FILL' 1" : "'FILL' 0";
			});
		};

		const syncLikesCount = async () => {
			const slugs = cards.map((c) => `knowhow/${c.dataset.id}`);
			try {
				const statesMap = await getBatchArticleLikeStates(slugs);
				if (destroyed) return;
				userLikedSlugs = new Set();
				statesMap.forEach((state, slug) => {
					const override = userLikeOverrides.get(slug);
					applyLikeState(slug, override?.isLiked ?? state.liked, override?.likeCount ?? state.likeCount);
				});
				userLikeOverrides.forEach((override, slug) => {
					if (!statesMap.has(slug)) applyLikeState(slug, override.isLiked, override.likeCount);
				});
				updateView();
			} catch {}
		};

		window.addEventListener('article-like-changed', (e: Event) => {
			const customEv = e as CustomEvent<Record<string, any>>;
			if (customEv.detail) {
				const targetSlug = String(customEv.detail.slug || '');
				const isLiked = Boolean(customEv.detail.liked || customEv.detail.isLiked);
				const likeCount = Number(customEv.detail.likeCount || 0);
				userLikeOverrides.set(targetSlug, { isLiked, likeCount });
				applyLikeState(targetSlug, isLiked, likeCount);
			}
		}, listenerOptions);

		const cleanup = () => {
			destroyed = true;
			window.clearTimeout(searchDebounce);
			swipeController?.destroy();
			filterSheetController?.destroy();
			sortSheetController?.destroy();
			listeners.abort();
			if (window.openModal === openChecklist) window.openModal = undefined;
			delete knowhowContainer.dataset.knowhowListInitialized;
		};
		document.addEventListener('astro:before-swap', cleanup, { once: true });

		refreshDisplayMode();
		updateView();
		updateUrl(false);
		void syncLikesCount();
		void initializePrivateDb().then(async () => {
			if (destroyed) return;
			if (!initialModeFromUrl) {
				const savedDisplayMode = await getPrivateSetting<DisplayMode>(DISPLAY_MODE_SETTING_KEY);
				if (destroyed) return;
				if (savedDisplayMode === 'grid_view' || savedDisplayMode === 'headline_view') {
					setDisplayMode(savedDisplayMode, false, false);
				}
			}
			if (!hasInitialPhase) {
				const savedPhases = await getPrivateSetting<PhaseFilter | PhaseFilter[]>(PHASE_SETTING_KEY);
				if (destroyed) return;
				const savedPhaseList = Array.isArray(savedPhases) ? savedPhases : savedPhases ? [savedPhases] : [];
				const validSavedPhases = savedPhaseList.filter((phase) => validPhases.has(phase));
				if (validSavedPhases.length > 0) {
					setPhases(validSavedPhases, false, false);
				}
			}
			await refreshFromSavedRuns();
		}).catch(() => {
			if (destroyed) return;
			isPrivateDbLoaded = true;
			knowhowContainer.dataset.privateStateLoaded = 'true';
			if (emptyMessage && currentListView === 'my') {
				emptyMessage.textContent = 'このブラウザーではマイリストを読み込めませんでした。';
			}
			updateView();
		});
	});
</script>

<style>
	.my-list-delete-action {
		position: absolute;
		inset-block: 0;
		right: 0;
		z-index: 0;
		display: flex;
		width: 5rem;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		border: 0;
		background-color: var(--color-red-700);
		color: #fff;
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.25rem;
	}

	.my-list-delete-action[hidden] {
		display: none;
	}


	#knowhow-container[data-display-mode="grid_view"] .my-list-delete-action {
		display: none !important;
	}

	#knowhow-container[data-display-mode="grid_view"] [data-my-list-swipe-row],
	#knowhow-container[data-display-mode="grid_view"] [data-my-list-swipe-content] {
		transform: translateX(0) !important;
		touch-action: auto;
		will-change: auto;
		cursor: default !important;
		pointer-events: auto !important;
	}

	#knowhow-container[data-display-mode="grid_view"] [data-my-list-swipe-content] {
