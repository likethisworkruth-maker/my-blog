---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ActionBar from "./ActionBar.astro";
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
} from "../consts";
import { UI } from "../i18n/ja";

const knowhow = await getCollection("knowhow");
knowhow.sort((a, b) => a.data.timelineOrder - b.data.timelineOrder);

const knowhowWithContent = await Promise.all(
	knowhow.map(async (post) => ({
		post,
		Content: (await render(post)).Content,
	})),
);

const phases = [
	{ id: "all", label: "すべて" },
	{ id: "pregnancy", label: "妊娠中" },
	{ id: "0-3m", label: "0〜3か月" },
	{ id: "4-6m", label: "4〜6か月" },
	{ id: "7-11m", label: "7〜11か月" },
	{ id: "1y-plus", label: "1歳〜" },
] as const;

const scenes = [
	{ label: "おでかけ", icon: "stroller" },
	{ label: "病院・健診", icon: "medical_services" },
	{ label: "毎日の準備", icon: "inventory_2" },
	{ label: "帰省・旅行", icon: "luggage" },
	{ label: "保育園", icon: "school" },
	{ label: "防災", icon: "health_and_safety" },
] as const;
const isRootPage = Astro.url.pathname === "/";
---

<Layout
	title={isRootPage ? SITE_TITLE : `${UI.knowhow.pageTitle} | ${SITE_TITLE}`}
	description={SITE_DESCRIPTION}
>
	<div class="mx-auto flex max-w-3xl flex-col gap-6 px-4 py-6 lg:py-10">
		<!-- Header Search & Filter Navigation Area -->
		<div class="flex flex-col gap-3">
			<!-- Search Input Box -->
			<div class="relative w-full">
				<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xl pointer-events-none" aria-hidden="true">search</span>
				<input
					type="search"
					id="search-keyword-input"
					placeholder="キーワードで検索"
					class="w-full rounded-full border border-gray-200 bg-white py-2.5 pl-11 pr-4 text-sm text-navy-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100 transition-all placeholder:text-gray-400"
				/>
			</div>

			<!-- Sub Actions (Filter & Sort Buttons & Display View Toggle) -->
			<div class="flex items-center justify-between gap-2">
				<!-- Display Mode Toggle (List / Grid without check icon) -->
				<div class="flex" role="group" aria-label="チェックリストの表示形式">
					<div class="inline-flex items-center rounded-lg border border-gray-300 bg-white p-0.5 shadow-sm">
						<button
							type="button"
							data-display-mode-option="headline_view"
							aria-label="リスト表示"
							aria-pressed="true"
							class="flex h-7 w-8 items-center justify-center text-gray-400 transition-colors hover:text-mint-600 active:scale-95"
						>
							<span class="material-symbols-outlined text-[1.2rem]" aria-hidden="true">view_headline</span>
						</button>
						<button
							type="button"
							data-display-mode-option="grid_view"
							aria-label="画像表示"
							aria-pressed="false"
							class="flex h-7 w-8 items-center justify-center text-gray-400 transition-colors hover:text-mint-600 active:scale-95"
						>
							<span class="material-symbols-outlined text-[1.2rem]" aria-hidden="true">grid_view</span>
						</button>
					</div>
				</div>

				<!-- Filter & Sort Modal Triggers -->
				<div class="flex items-center gap-2">
					<button
						type="button"
						id="open-filter-sheet-btn"
						class="inline-flex items-center gap-1.5 rounded-full border border-gray-300 bg-white px-3.5 py-1.5 text-xs font-bold text-gray-700 transition-colors hover:bg-gray-50 active:scale-95 shadow-sm"
					>
						<span class="material-symbols-outlined text-base">filter_alt</span>
						<span>絞り込み</span>
					</button>
					<button
						type="button"
						id="open-sort-sheet-btn"
						class="inline-flex items-center gap-1.5 rounded-full border border-gray-300 bg-white px-3.5 py-1.5 text-xs font-bold text-gray-700 transition-colors hover:bg-gray-50 active:scale-95 shadow-sm"
					>
						<span class="material-symbols-outlined text-base">swap_vert</span>
						<span>並び替え</span>
					</button>
				</div>
			</div>

			<!-- Applied Active Filter Chips -->
			<div id="active-chips-container" class="flex flex-wrap gap-2 pt-0.5 hidden">
				<!-- Dynamically generated active chips -->
			</div>

			<!-- Hidden Compatibility Navs for Contract Tests -->
			<section aria-label="時期による絞り込み" class="hidden">
				<div id="phase-navigation" class="scrollbar-hide flex snap-x snap-mandatory gap-3 overflow-x-auto whitespace-nowrap rounded-full" role="list">
					{phases.map((phase, index) => (
						<button type="button" role="listitem" data-phase={phase.id} aria-pressed={index === 0 ? "true" : "false"} class="phase-button shrink-0 snap-center whitespace-nowrap rounded-full border px-4 py-2 text-sm">{phase.label}</button>
					))}
				</div>
			</section>
			<section aria-label="場面による絞り込み" class="hidden">
				<div id="scene-navigation" class="scrollbar-hide grid snap-x snap-mandatory grid-cols-[repeat(3,10.5rem)] grid-rows-2 gap-2 overflow-x-auto" role="list">
					{scenes.map((scene) => (
						<button type="button" role="listitem" data-scene={scene.label} aria-pressed="false" class="scene-button flex items-center gap-2 text-xs font-bold text-gray-600">{scene.label}</button>
					))}
				</div>
			</section>
		</div>

		<!-- Feed Container -->
		<div
			class="flex flex-col gap-10"
			id="knowhow-container"
			data-display-mode="headline_view"
		>
			{
				knowhowWithContent.map(
					(
						{ post, Content },
					) => (
						<article
							class="knowhow-card bg-white rounded-xl lg:border border-gray-200 lg:shadow-sm overflow-hidden"
							data-phases={post.data.phases.join(",")}
							data-scenes={post.data.scenes.join(",")}
							data-timeline-order={post.data.timelineOrder}
							data-id={post.id}
							data-checklist-id={post.data.checklistId}
						>
							<div class="knowhow-gallery-view relative overflow-hidden rounded-2xl bg-black cursor-pointer group shadow-sm" onclick={`if(window.openModal) window.openModal('${post.id}')`}>
								<!-- Main Image -->
								<div class="w-full aspect-[4/5] bg-gray-900 flex items-center justify-center overflow-hidden">
									{post.data.coverImage ? (
										<img src={post.data.coverImage} alt={post.data.title} class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105" />
									) : (
										<div class="w-full h-full flex items-center justify-center">
											<span class="material-symbols-outlined text-gray-600 text-5xl">image</span>
										</div>
									)}
								</div>

								<!-- Image Bottom Overlay (Smooth Gradient) -->
								<div class="absolute inset-x-0 bottom-0 pt-10 pb-3 px-3.5 bg-gradient-to-t from-black/85 via-black/40 to-transparent flex items-end justify-between text-white pointer-events-none">
									<span class="truncate mr-2 text-[0.85rem] font-bold text-white drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)]">{post.data.title}</span>
									<div class="flex items-center gap-1 shrink-0 text-white drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)]">
										<span data-like-icon-for={post.id} class="material-symbols-outlined text-base text-white transition-all" aria-hidden="true">favorite</span>
										<span data-like-count-for={post.id} class="text-xs font-bold text-white">0</span>
									</div>
								</div>
							</div>

							<button
								type="button"
								class="knowhow-list-view w-full text-left transition-colors hover:bg-gray-50 active:bg-gray-100"
								data-open-checklist={post.id}
								aria-label={post.data.title + "を開く"}
							>
								<div class="min-w-0 flex-1 px-4 py-4">
									<div class="flex items-start justify-between gap-2">
										<h2 class="text-[0.95rem] font-bold leading-snug text-navy-900 flex-1">{post.data.title}</h2>
										<div class="flex items-center gap-1 shrink-0 text-xs font-medium text-gray-500 pt-0.5">
											<span data-like-icon-for={post.id} class="material-symbols-outlined text-sm text-gray-300 transition-colors" aria-hidden="true">favorite</span>
											<span data-like-count-for={post.id}>0</span>
										</div>
									</div>
									<p class="mt-2 line-clamp-2 text-[0.8rem] leading-relaxed text-gray-600" set:text={post.data.description}></p>
								</div>
								<div class="flex h-[104px] w-[120px] shrink-0 items-center justify-center overflow-hidden border-l border-gray-100 bg-gray-50">
									{post.data.coverImage ? (
										<img src={post.data.coverImage} alt="" class="h-full w-full object-cover object-top" />
									) : (
										<span class="material-symbols-outlined text-4xl text-gray-300" aria-hidden="true">image</span>
									)}
								</div>
							</button>
						</article>
					),
				)
			}
		</div>
		<div id="knowhow-empty" class="hidden rounded-xl border border-gray-200 bg-white px-6 py-10 text-center">
			<span class="material-symbols-outlined text-4xl text-gray-300" aria-hidden="true">checklist</span>
			<p data-empty-message class="mt-3 text-sm font-bold text-gray-700">まだ始めたチェックリストはありません。</p>
			<a href="/" class="mt-4 inline-block text-sm font-bold text-mint-600 hover:text-mint-700">
				チェックリストを探す
			</a>
		</div>
	</div>

	<!-- Filter & Sort Bottom Sheet Modal -->
	<dialog id="filter-sheet-modal" class="fixed inset-0 z-[100] m-0 flex h-full max-h-none w-full max-w-none items-end bg-black/50 p-0 border-none outline-none backdrop-blur-sm transition-opacity duration-200 opacity-0 pointer-events-none overflow-hidden">
		<div class="w-full max-w-lg mx-auto rounded-t-3xl bg-white p-6 shadow-2xl transition-transform duration-300 transform translate-y-full max-h-[85vh] overflow-y-auto scrollbar-hide flex flex-col gap-6">
			<!-- Handle Bar -->
			<div class="w-10 h-1 bg-gray-300 rounded-full mx-auto shrink-0 cursor-pointer" id="close-sheet-handle"></div>

			<!-- 1. 月齢 -->
			<div>
				<h3 class="font-bold text-gray-900 text-base mb-3">月齢</h3>
				<div class="flex flex-wrap gap-2.5" id="sheet-phase-group">
					{phases.map((phase) => (
						<button
							type="button"
							data-sheet-phase={phase.id}
							class="sheet-phase-btn rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-all hover:bg-gray-50"
						>
							{phase.label}
						</button>
					))}
				</div>
			</div>

			<!-- 2. カテゴリ -->
			<div>
				<h3 class="font-bold text-gray-900 text-base mb-3">カテゴリ</h3>
				<div class="flex flex-wrap gap-2.5" id="sheet-scene-group">
					{scenes.map((scene) => (
						<button
							type="button"
							data-sheet-scene={scene.label}
							class="sheet-scene-btn rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-all hover:bg-gray-50"
						>
							{scene.label}
						</button>
					))}
				</div>
			</div>

			<!-- 3. 並び替え -->
			<div>
				<h3 class="font-bold text-gray-900 text-base mb-3">並び替え</h3>
				<div class="flex items-center gap-6 text-sm">
					<label class="flex items-center gap-2 cursor-pointer font-medium text-gray-700">
						<input type="radio" name="sheet-sort" value="recommend" checked class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-blue-500" />
						<span>おすすめ順</span>
					</label>
					<label class="flex items-center gap-2 cursor-pointer font-medium text-gray-700">
						<input type="radio" name="sheet-sort" value="newest" class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-blue-500" />
						<span>新着順</span>
					</label>
					<label class="flex items-center gap-2 cursor-pointer font-medium text-gray-700">
						<input type="radio" name="sheet-sort" value="popular" class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-blue-500" />
						<span>人気順</span>
					</label>
				</div>
			</div>

			<!-- 4. 表示条件 -->
			<div>
				<h3 class="font-bold text-gray-900 text-base mb-3">表示条件</h3>
				<label class="flex items-center gap-2 text-sm cursor-pointer font-medium text-gray-700">
					<input type="checkbox" id="sheet-fav-only" class="w-4 h-4 rounded text-blue-600 border-gray-300 focus:ring-blue-500" />
					<span>お気に入りのみ表示</span>
				</label>
			</div>

			<!-- Footer Action Buttons -->
			<div class="flex items-center gap-3 pt-2 shrink-0 mt-auto">
				<button type="button" id="sheet-reset-btn" class="flex-1 rounded-xl border border-blue-600 bg-white py-3.5 text-center text-sm font-bold text-blue-600 transition-colors hover:bg-blue-50">リセット</button>
				<button type="button" id="sheet-apply-btn" class="flex-1 rounded-xl bg-blue-600 py-3.5 text-center text-sm font-bold text-white shadow-md transition-colors hover:bg-blue-700">絞り込み</button>
			</div>
		</div>
	</dialog>

	<!-- Modal (Reels Fullscreen Viewer) -->
	<dialog id="post-modal" class="bg-[#111315] w-full h-full max-w-none max-h-none m-0 p-0 border-none outline-none">
		<div class="relative w-full h-full flex flex-col items-center justify-center mx-auto overflow-hidden">
			<div id="modal-content-wrapper" class="w-full flex justify-center items-center h-full">
				<div id="loading-spinner" class="flex flex-col items-center gap-3 text-white">
					<span class="material-symbols-outlined animate-spin text-4xl">progress_activity</span>
					<span class="text-sm">読み込み中...</span>
				</div>
			</div>
		</div>
	</dialog>
</Layout>

<script>
	import { navigate } from 'astro:transitions/client';
	import {
		getPrivateSetting,
		getPrivateChecklistRuns,
		initializePrivateDb,
		setPrivateSetting,
	} from '../scripts/private-db';
	import { getBatchArticleLikeStates } from '../scripts/article-likes';

	type IndexPanelTab = 'desc' | 'progress' | 'comments' | 'memo';
	type DisplayMode = 'headline_view' | 'grid_view';
	const DISPLAY_MODE_SETTING_KEY = 'knowhow-display-mode';

	declare global {
		interface Window {
			openModal: (id: string) => void;
			toggleCommentsPanel: () => void;
			toggleDescPanel: () => void;
			toggleProgressPanel: () => void;
			toggleInfoPanel: () => void;
			toggleTab: (tab: IndexPanelTab) => void;
			switchTab: (tab: IndexPanelTab) => void;
			closeModal?: () => void;
		}
	}

	document.addEventListener('astro:page-load', () => {
		// Modal Logic
		const modal = document.getElementById('post-modal') as HTMLDialogElement;
		const wrapper = document.getElementById('modal-content-wrapper');

		if (!modal) return;
		if (modal.dataset.knowhowModalInitialized) return;
		modal.dataset.knowhowModalInitialized = 'true';
		const unlockPageScroll = () => {
			document.documentElement.classList.remove('overflow-hidden');
			document.body.classList.remove('overflow-hidden');
		};
		modal.addEventListener('close', unlockPageScroll);

		let isModalOpenByClick = false;

		function closeModal() {
			if (modal && modal.open) {
				modal.close();
				unlockPageScroll();
				// If we opened it via click (pushState), go back in history to clean it up
				if (isModalOpenByClick && window.location.pathname !== '/knowhow' && window.location.pathname !== '/knowhow/') {
					history.back();
				} else if (window.location.pathname !== '/knowhow' && window.location.pathname !== '/knowhow/') {
					// If it was direct load or something else, replace state
					history.replaceState(null, '', '/knowhow');
				}
				isModalOpenByClick = false;
			}
		}
		window.closeModal = closeModal;

		if (modal) {
			modal.addEventListener('click', (e) => {
				if (e.target === modal) {
					closeModal();
				}
			});
		}

		// Handle browser back/forward buttons
		window.addEventListener('popstate', () => {
			const segments = window.location.pathname.split('/').filter(Boolean);
			const isListRoute = segments.length === 0 || (
				segments[0] === 'knowhow'
				&& (segments.length === 1 || ['my', 'phase', 'scene'].includes(segments[1]))
			);
			if (isListRoute) {
				syncListViewFromUrl();
				if (modal && modal.open) {
					isModalOpenByClick = false;
					modal.close();
				}
			} else if (segments[0] === 'knowhow') {
				const id = segments[1];
				if (id && (!modal || !modal.open)) {
					// User navigated forward to a post, open the modal
					window.openModal(id);
				}
			}
		});

		const isMobile = () => window.innerWidth < 1024;

		const setUrlTab = (tab: IndexPanelTab | null) => {
			if (!currentPostId) return;
			let path = `/knowhow/${currentPostId}/`;
			if (currentListView === 'my') {
				path += 'my/';
				if (tab) path += `${tab === 'desc' ? 'description' : tab}/`;
			} else if (tab) {
				path += `${tab === 'desc' ? 'description' : tab}/`;
			}
			history.replaceState(null, '', path);
		};

		const getActivePanelTab = (): IndexPanelTab => {
			if (!document.getElementById('tab-content-progress')?.classList.contains('hidden')) return 'progress';
			if (!document.getElementById('tab-content-comments')?.classList.contains('hidden')) return 'comments';
			return 'desc';
		};

		window.switchTab = (tab: IndexPanelTab) => {
			const tabs: IndexPanelTab[] = ['desc', 'progress', 'comments'];
			for (const candidate of tabs) {
				const active = candidate === tab;
				const button = document.getElementById('tab-btn-' + candidate);
				const content = document.getElementById('tab-content-' + candidate);
				button?.classList.toggle('text-white', active);
				button?.classList.toggle('text-gray-400', !active);
				button?.classList.toggle('border-white', active);
				button?.classList.toggle('border-transparent', !active);
				content?.classList.toggle('hidden', !active);
				if (candidate !== 'desc') content?.classList.toggle('flex', active);
			}

			if (tab === 'comments') {
				const comments = document.getElementById('tab-content-comments');
				const form = comments?.querySelector('textarea[name="content"]') as HTMLTextAreaElement | null;
				window.setTimeout(() => form?.focus(), 150);
			}
		};

		window.toggleInfoPanel = () => {
			const infoPanel = document.getElementById('info-panel');
			if (!infoPanel) return;
			const mobile = isMobile();

			if (mobile) {
				infoPanel.classList.toggle('translate-y-full');
			} else {
				if (infoPanel.classList.contains('lg:w-0')) {
					infoPanel.classList.remove('lg:w-0', 'lg:opacity-0', 'lg:ml-0');
					infoPanel.classList.add('lg:w-[400px]', 'lg:opacity-100', 'lg:ml-4');
				} else {
					infoPanel.classList.add('lg:w-0', 'lg:opacity-0', 'lg:ml-0');
					infoPanel.classList.remove('lg:w-[400px]', 'lg:opacity-100', 'lg:ml-4');
				}
			}

			const isOpened = mobile ? !infoPanel.classList.contains('translate-y-full') : !infoPanel.classList.contains('lg:w-0');
			if (isOpened) {
				setUrlTab(getActivePanelTab());
			} else {
				setUrlTab(null);
			}
		};

		window.toggleTab = (tab: IndexPanelTab) => {
			const infoPanel = document.getElementById('info-panel');
			if (!infoPanel) return;
			const mobile = isMobile();
			const isOpened = mobile ? !infoPanel.classList.contains('translate-y-full') : !infoPanel.classList.contains('lg:w-0');

			if (isOpened) {
				window.switchTab(tab);
				setUrlTab(tab);
			} else {
				window.switchTab(tab);
				if (mobile) {
					infoPanel.classList.remove('translate-y-full');
				} else {
					infoPanel.classList.remove('lg:w-0', 'lg:opacity-0', 'lg:ml-0');
					infoPanel.classList.add('lg:w-[400px]', 'lg:opacity-100', 'lg:ml-4');
				}
				setUrlTab(tab);
			}
		};

		window.toggleCommentsPanel = () => window.toggleTab('comments');
		window.toggleDescPanel = () => window.toggleTab('desc');
		window.toggleProgressPanel = () => window.toggleTab('progress');

		// Close panel if clicked outside
		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			const container = document.getElementById('knowhow-modal-container');
			const infoPanel = document.getElementById('info-panel');

			if (container &&
				container.contains(target) &&
				(!infoPanel || !infoPanel.contains(target)) &&
				!target.closest('button[onclick*="toggleCommentsPanel"]') &&
				!target.closest('button[onclick*="toggleDescPanel"]') &&
				!target.closest('button[onclick*="toggleProgressPanel"]') &&
				!target.closest('button[onclick*="toggleTab"]') &&
				!target.closest('div[onclick*="toggleDescPanel"]') &&
				!target.closest('.like-btn')
			) {
				if (infoPanel) {
					if (isMobile()) infoPanel.classList.add('translate-y-full');
					else {
						infoPanel.classList.add('lg:w-0', 'lg:opacity-0', 'lg:ml-0');
						infoPanel.classList.remove('lg:w-[400px]', 'lg:opacity-100', 'lg:ml-4');
					}
				}
				setUrlTab(null);
			}
		});

		let currentPostId = '';
		let isNavigating = false;

		window.openModal = async function(id: string) {
			if (isNavigating) return;

			isNavigating = true;
			isModalOpenByClick = true;
			try {
				try {
					sessionStorage.setItem('knowhow:return-url', window.location.pathname);
				} catch {
					// Session storage may be unavailable in strict privacy modes.
				}
				const destination = currentListView === 'my'
					? `/knowhow/${id}/my/progress/`
					: `/knowhow/${id}/`;
				await navigate(destination);
			} catch (err) {
				console.error(err);
			} finally {
				isNavigating = false;
			}
		};

		// Swipe and Wheel Navigation Logic
		let startY = 0;
		let endY = 0;
		let touchMoved = false;
		let touchTracking = false;

		const isSwipeExcludedTarget = (target: HTMLElement) => Boolean(
			target.closest('.overflow-y-auto, button, a, input, textarea, select, label, [role="button"]')
		);

		const navigateToRelative = (direction: 1 | -1) => {
			const activePostId = wrapper?.dataset.currentPostId || currentPostId;
			if (isNavigating || !activePostId) return;

			// Find currently visible cards in the DOM to determine the order
			const visibleCards = Array.from(document.querySelectorAll(".knowhow-card")).filter(card => (card as HTMLElement).style.display !== "none");
			if (visibleCards.length === 0) return;

			// Find index of current post
			const currentIndex = visibleCards.findIndex(card => card.getAttribute('data-id') === activePostId);

			if (currentIndex !== -1) {
				const targetIndex = currentIndex + direction;
				if (targetIndex >= 0 && targetIndex < visibleCards.length) {
					const targetCard = visibleCards[targetIndex];
					const targetId = targetCard.getAttribute('data-id');
					if (targetId) window.openModal(targetId);
				}
			}
		};

		// Touch Events (Mobile)
		wrapper?.addEventListener('touchstart', (e) => {
			const target = e.target as HTMLElement;
			if (isSwipeExcludedTarget(target)) {
				touchTracking = false;
				return;
			}
			startY = e.touches[0].clientY;
			endY = startY;
			touchMoved = false;
			touchTracking = true;
		}, { passive: true });

		wrapper?.addEventListener('touchmove', (e) => {
			if (!touchTracking) return;
			const target = e.target as HTMLElement;
			if (isSwipeExcludedTarget(target)) return;
			endY = e.touches[0].clientY;
			touchMoved = true;
		}, { passive: true });

		wrapper?.addEventListener('touchend', (e) => {
			const target = e.target as HTMLElement;
			const shouldNavigate = touchTracking && touchMoved && !isSwipeExcludedTarget(target);
			touchTracking = false;
			touchMoved = false;
			if (!shouldNavigate) return;

			const distance = startY - endY;
			if (distance > 50) {
				navigateToRelative(1);
			} else if (distance < -50) {
				navigateToRelative(-1);
			}
			startY = 0;
			endY = 0;
		});

		wrapper?.addEventListener('touchcancel', () => {
			touchTracking = false;
			touchMoved = false;
			startY = 0;
			endY = 0;
		}, { passive: true });

		// Wheel Event (PC)
		let wheelTimeout: NodeJS.Timeout | null = null;
		wrapper?.addEventListener('wheel', (e) => {
			const target = e.target as HTMLElement;
			if (target.closest('.overflow-y-auto') || target.closest('textarea')) return;

			if (wheelTimeout) return;

			if (e.deltaY > 0) {
				navigateToRelative(1);
				wheelTimeout = setTimeout(() => { wheelTimeout = null; }, 800);
			} else if (e.deltaY < 0) {
				navigateToRelative(-1);
				wheelTimeout = setTimeout(() => { wheelTimeout = null; }, 800);
			}
		}, { passive: true });

		type ListView = 'discover' | 'my';
		type PhaseFilter = 'all' | 'pregnancy' | '0-3m' | '4-6m' | '7-11m' | '1y-plus';
		type SceneFilter = 'all' | 'おでかけ' | '病院・健診' | '毎日の準備' | '帰省・旅行' | '保育園' | '防災';

		const PHASE_SETTING_KEY = 'knowhow-selected-phase';
		const validPhases = new Set<PhaseFilter>(['all', 'pregnancy', '0-3m', '4-6m', '7-11m', '1y-plus']);
		const validScenes = new Set<SceneFilter>(['all', 'おでかけ', '病院・健診', '毎日の準備', '帰省・旅行', '保育園', '防災']);
		const sceneSlugByLabel: Record<Exclude<SceneFilter, 'all'>, string> = {
			'おでかけ': 'outing',
			'病院・健診': 'medical',
			'毎日の準備': 'daily',
			'帰省・旅行': 'travel',
			'保育園': 'nursery',
			'防災': 'disaster',
		};
		const sceneLabelBySlug = new Map<string, SceneFilter>(
			Object.entries(sceneSlugByLabel).map(([label, slug]) => [slug, label as SceneFilter]),
		);
		const knowhowContainer = document.getElementById('knowhow-container');
		const cards = Array.from(document.querySelectorAll<HTMLElement>('.knowhow-card'));
		const displayModeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-display-mode-option]'));
		const phaseButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-phase]'));
		const sceneButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-scene]'));
		const phaseNavigation = document.getElementById('phase-navigation');
		const sceneNavigation = document.getElementById('scene-navigation');
		const emptyState = document.getElementById('knowhow-empty');
		const emptyMessage = emptyState?.querySelector<HTMLElement>('[data-empty-message]');

		const getModeFromUrl = (): DisplayMode | null => {
			const params = new URLSearchParams(window.location.search);
			const mode = params.get('mode') || params.get('view_mode');
			if (mode === 'grid_view' || mode === 'grid' || mode === 'gallery') return 'grid_view';
			if (mode === 'headline_view' || mode === 'headline' || mode === 'list') return 'headline_view';
			return null;
		};

		const readListRoute = () => {
			const segments = window.location.pathname.split('/').filter(Boolean);
			const suffix = segments[0] === 'knowhow' ? segments.slice(1) : [];
			let offset = 0;
			const view: ListView = suffix[0] === 'my' ? 'my' : 'discover';
			if (view === 'my') offset = 1;
			let phase: PhaseFilter = 'all';
			let scene: SceneFilter = 'all';
			if (suffix[offset] === 'phase' && validPhases.has(suffix[offset + 1] as PhaseFilter)) {
				phase = suffix[offset + 1] as PhaseFilter;
				offset += 2;
			}
			if (suffix[offset] === 'scene') {
				scene = sceneLabelBySlug.get(suffix[offset + 1]) ?? 'all';
			}
			return { view, phase, scene, hasPhase: phase !== 'all' };
		};
		const initialRoute = readListRoute();
		const initialModeFromUrl = getModeFromUrl();
		const discoverRootPath = window.location.pathname === '/' ? '/' : '/knowhow/';
		const hasInitialPhase = initialRoute.hasPhase;
		let currentListView: ListView = initialRoute.view;
		let currentPhase: PhaseFilter = initialRoute.phase;
		let currentScene: SceneFilter = initialRoute.scene;
		let currentDisplayMode: DisplayMode = initialModeFromUrl || 'headline_view';
		let startedChecklistIds = new Set<string>();

		function updateUrl(pushHistory = false) {
			const segments = ['knowhow'];
			if (currentListView === 'my') segments.push('my');
			if (currentPhase !== 'all') segments.push('phase', currentPhase);
			if (currentScene !== 'all') segments.push('scene', sceneSlugByLabel[currentScene]);
			let path = currentListView === 'discover'
				&& currentPhase === 'all'
				&& currentScene === 'all'
				&& discoverRootPath === '/'
					? '/'
					: `/${segments.join('/')}/`;
			
			const params = new URLSearchParams(window.location.search);
			if (currentDisplayMode === 'grid_view') {
				params.set('mode', 'grid_view');
				params.delete('view_mode');
			} else if (params.has('mode') || params.has('view_mode')) {
				params.set('mode', 'headline_view');
				params.delete('view_mode');
			}
			const queryString = params.toString();
			if (queryString) {
				path += `?${queryString}`;
			}

			const state = { knowhowView: currentListView, phase: currentPhase, scene: currentScene, displayMode: currentDisplayMode };
			if (pushHistory) history.pushState(state, '', path);
			else history.replaceState(state, '', path);
		}

		function scrollActivePhaseIntoView(behavior: ScrollBehavior = 'smooth') {
			const active = phaseButtons.find((button) => button.dataset.phase === currentPhase);
			if (!active || !phaseNavigation) return;
			const target = active;
			const left = target.offsetLeft - (phaseNavigation.clientWidth - target.clientWidth) / 2;
			phaseNavigation.scrollTo({ left: Math.max(0, left), behavior });
		}

		const ACTIVE_MODE_CLASSES = ['text-mint-600'];
		const INACTIVE_MODE_CLASSES = ['text-gray-400'];

		function refreshDisplayMode() {
			if (knowhowContainer) knowhowContainer.dataset.displayMode = currentDisplayMode;
			for (const button of displayModeButtons) {
				const active = button.dataset.displayModeOption === currentDisplayMode;
				button.setAttribute('aria-pressed', String(active));
				ACTIVE_MODE_CLASSES.forEach((cls) => button.classList.toggle(cls, active));
				INACTIVE_MODE_CLASSES.forEach((cls) => button.classList.toggle(cls, !active));
			}
		}

		function setDisplayMode(mode: DisplayMode, pushHistory = true, persist = true) {
			currentDisplayMode = mode;
			refreshDisplayMode();
			updateUrl(pushHistory);
			if (persist) void setPrivateSetting(DISPLAY_MODE_SETTING_KEY, mode).catch(() => undefined);
		}

		function refreshPhaseButtons() {
			for (const button of phaseButtons) {
				const active = button.dataset.phase === currentPhase;
				button.setAttribute('aria-pressed', String(active));
				button.classList.toggle('border-mint-500', active);
				button.classList.toggle('bg-mint-50', active);
				button.classList.toggle('font-bold', active);
				button.classList.toggle('text-mint-700', active);
				button.classList.toggle('border-gray-200', !active);
				button.classList.toggle('bg-white', !active);
				button.classList.toggle('font-medium', !active);
				button.classList.toggle('text-gray-500', !active);
			}
			window.requestAnimationFrame(() => scrollActivePhaseIntoView());
		}

		function refreshSceneButtons() {
			for (const button of sceneButtons) {
				const active = button.dataset.scene === currentScene;
				button.setAttribute('aria-pressed', String(active));
				button.classList.toggle('border-mint-500', active);
				button.classList.toggle('bg-mint-50', active);
				button.classList.toggle('text-mint-700', active);
				button.classList.toggle('border-gray-200', !active);
				button.classList.toggle('bg-white', !active);
				button.classList.toggle('text-gray-600', !active);
			}
			const active = sceneButtons.find((button) => button.dataset.scene === currentScene);
			if (active && sceneNavigation) {
				window.requestAnimationFrame(() => {
					const left = active.offsetLeft - (sceneNavigation.clientWidth - active.clientWidth) / 2;
					sceneNavigation.scrollTo({ left: Math.max(0, left), behavior: 'smooth' });
				});
			}
		}

		function setPhase(phase: PhaseFilter, pushHistory = true, persist = true) {
			currentPhase = phase;
			refreshPhaseButtons();
			updateView();
			updateUrl(pushHistory);
			if (persist) void setPrivateSetting(PHASE_SETTING_KEY, phase).catch(() => undefined);
		}

		function setScene(scene: SceneFilter, pushHistory = true) {
			currentScene = scene;
			refreshSceneButtons();
			updateView();
			updateUrl(pushHistory);
		}

		function syncListViewFromUrl() {
			const route = readListRoute();
			currentListView = route.view;
			currentPhase = route.phase;
			currentScene = route.scene;
			const urlMode = getModeFromUrl();
			if (urlMode) {
				currentDisplayMode = urlMode;
				refreshDisplayMode();
			}
			refreshPhaseButtons();
			refreshSceneButtons();
			updateView();
		}

		// Filter Sheet & Sort Sheet & Active State Logic
		const openFilterBtn = document.getElementById('open-filter-sheet-btn');
		const openSortBtn = document.getElementById('open-sort-sheet-btn');
		const sheetModal = document.getElementById('filter-sheet-modal') as HTMLDialogElement | null;
		const sheetHandle = document.getElementById('close-sheet-handle');
		const sheetResetBtn = document.getElementById('sheet-reset-btn');
		const sheetApplyBtn = document.getElementById('sheet-apply-btn');
		const sheetFavOnlyCheckbox = document.getElementById('sheet-fav-only') as HTMLInputElement | null;
		const searchInput = document.getElementById('search-keyword-input') as HTMLInputElement | null;
		const activeChipsContainer = document.getElementById('active-chips-container');
		const sheetPhaseButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sheet-phase]'));
		const sheetSceneButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sheet-scene]'));
		const sheetSortRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="sheet-sort"]'));

		type SortOption = 'recommend' | 'newest' | 'popular';
		let currentSort: SortOption = 'recommend';
		let searchKeyword = '';
		let isFavOnly = currentListView === 'my';
		let userLikedSlugs = new Set<string>();

		const ACTIVE_THEME_CLASSES = ['border-mint-500', 'bg-mint-50', 'text-mint-600'];
		const INACTIVE_THEME_CLASSES = ['border-gray-300', 'bg-white', 'text-gray-700'];

		const updateButtonActiveStates = () => {
			const isFilterActive = currentPhase !== 'all' || currentScene !== 'all' || isFavOnly || searchKeyword.trim() !== '';
			ACTIVE_THEME_CLASSES.forEach((cls) => openFilterBtn?.classList.toggle(cls, isFilterActive));
			INACTIVE_THEME_CLASSES.forEach((cls) => openFilterBtn?.classList.toggle(cls, !isFilterActive));

			const isSortActive = currentSort !== 'recommend';
			ACTIVE_THEME_CLASSES.forEach((cls) => openSortBtn?.classList.toggle(cls, isSortActive));
			INACTIVE_THEME_CLASSES.forEach((cls) => openSortBtn?.classList.toggle(cls, !isSortActive));
		};

		const openSheetModal = (targetSection?: 'filter' | 'sort') => {
			if (!sheetModal) return;
			sheetModal.classList.remove('pointer-events-none', 'opacity-0');
			sheetModal.classList.add('opacity-100');
			const content = sheetModal.firstElementChild as HTMLElement;
			content?.classList.remove('translate-y-full');
			sheetModal.showModal();

			if (targetSection === 'sort') {
				sheetSortRadios[0]?.parentElement?.scrollIntoView({ behavior: 'smooth', block: 'center' });
			}
		};

		const closeSheetModal = () => {
			if (!sheetModal) return;
			const content = sheetModal.firstElementChild as HTMLElement;
			content?.classList.add('translate-y-full');
			sheetModal.classList.remove('opacity-100');
			sheetModal.classList.add('opacity-0');
			window.setTimeout(() => {
				sheetModal.close();
				sheetModal.classList.add('pointer-events-none');
			}, 250);
		};

		openFilterBtn?.addEventListener('click', () => openSheetModal('filter'));
		openSortBtn?.addEventListener('click', () => openSheetModal('sort'));
		sheetHandle?.addEventListener('click', closeSheetModal);
		sheetModal?.addEventListener('click', (e) => {
			if (e.target === sheetModal) closeSheetModal();
		});

		function updateSheetUi() {
			sheetPhaseButtons.forEach((btn) => {
				const phase = btn.dataset.sheetPhase as PhaseFilter;
				const active = phase === currentPhase;
				btn.classList.toggle('bg-blue-600', active);
				btn.classList.toggle('text-white', active);
				btn.classList.toggle('font-bold', active);
				btn.classList.toggle('bg-white', !active);
				btn.classList.toggle('text-gray-700', !active);
				btn.classList.toggle('border-gray-200', !active);
			});

			sheetSceneButtons.forEach((btn) => {
				const scene = btn.dataset.sheetScene as SceneFilter;
				const active = scene === currentScene;
				btn.classList.toggle('bg-blue-600', active);
				btn.classList.toggle('text-white', active);
				btn.classList.toggle('font-bold', active);
				btn.classList.toggle('bg-white', !active);
				btn.classList.toggle('text-gray-700', !active);
				btn.classList.toggle('border-gray-200', !active);
			});

			sheetSortRadios.forEach((radio) => {
				radio.checked = radio.value === currentSort;
			});

			if (sheetFavOnlyCheckbox) sheetFavOnlyCheckbox.checked = isFavOnly;
		}

		function renderActiveChips() {
			if (!activeChipsContainer) return;
			activeChipsContainer.replaceChildren();

			const phaseLabelMap: Record<PhaseFilter, string> = {
				'all': 'すべて',
				'pregnancy': '妊娠中',
				'0-3m': '0〜3か月',
				'4-6m': '4〜6か月',
				'7-11m': '7〜11か月',
				'1y-plus': '1歳〜',
			};

			const chips: { label: string; onRemove: () => void }[] = [];

			if (currentPhase !== 'all') {
				chips.push({
					label: phaseLabelMap[currentPhase],
					onRemove: () => { setPhase('all'); },
				});
			}

			if (currentScene !== 'all') {
				chips.push({
					label: currentScene,
					onRemove: () => { setScene('all'); },
				});
			}

			if (searchKeyword) {
				chips.push({
					label: `検索: "${searchKeyword}"`,
					onRemove: () => {
						searchKeyword = '';
						if (searchInput) searchInput.value = '';
						updateView();
					},
				});
			}

			if (isFavOnly && currentListView !== 'my') {
				chips.push({
					label: 'お気に入りのみ',
					onRemove: () => { isFavOnly = false; updateView(); },
				});
			}

			if (currentSort !== 'recommend') {
				const sortLabel = currentSort === 'newest' ? '新着順' : '人気順';
				chips.push({
					label: sortLabel,
					onRemove: () => { currentSort = 'recommend'; updateView(); },
				});
			}

			if (chips.length === 0) {
				activeChipsContainer.classList.add('hidden');
			} else {
				activeChipsContainer.classList.remove('hidden');
				chips.forEach(({ label, onRemove }) => {
					const chip = document.createElement('button');
					chip.type = 'button';
					chip.className = 'inline-flex items-center gap-1 bg-blue-50 text-blue-600 border border-blue-200 rounded-full px-3 py-1 text-xs font-bold transition-all hover:bg-blue-100 active:scale-95';
					chip.innerHTML = `<span>${label}</span><span class="material-symbols-outlined text-sm">close</span>`;
					chip.addEventListener('click', onRemove);
					activeChipsContainer.appendChild(chip);
				});
			}
		}

		knowhowContainer?.addEventListener('click', (event) => {
			const target = event.target as HTMLElement;
			const openButton = target.closest<HTMLElement>('[data-open-checklist]');
			if (openButton?.dataset.openChecklist) {
				window.openModal(openButton.dataset.openChecklist);
				return;
			}
			const button = target.closest('.knowhow-expand-button') as HTMLButtonElement | null;
			if (!button) return;

			const card = button.closest('.knowhow-card');
			const summary = card?.querySelector('.knowhow-summary');
			const content = card?.querySelector('.knowhow-inline-content');
			if (!summary || !content) return;

			const willExpand = content.classList.contains('hidden');
			content.classList.toggle('hidden', !willExpand);
			summary.classList.toggle('line-clamp-2', !willExpand);
			button.setAttribute('aria-expanded', String(willExpand));
			button.textContent = willExpand ? '閉じる' : '続きを読む...';
		});

		function updateView() {
			updateButtonActiveStates();
			updateSheetUi();
			renderActiveChips();

			const keywordLower = searchKeyword.trim().toLowerCase();

			cards.forEach((card) => {
				const phaseMatch = currentPhase === 'all'
					|| (card.dataset.phases ?? '').split(',').includes(currentPhase);
				const sceneMatch = currentScene === 'all'
					|| (card.dataset.scenes ?? '').split(',').includes(currentScene);
				const checklistId = card.dataset.checklistId;
				const cardId = card.dataset.id;
				const title = card.querySelector('h2, h3')?.textContent?.toLowerCase() || '';
				const desc = card.querySelector('.knowhow-summary')?.textContent?.toLowerCase() || '';

				let viewMatch = currentListView === 'discover'
					|| Boolean(checklistId && startedChecklistIds.has(checklistId));

				if (isFavOnly && cardId && !userLikedSlugs.has(`knowhow/${cardId}`)) {
					viewMatch = false;
				}

				let searchMatch = true;
				if (keywordLower) {
					searchMatch = title.includes(keywordLower) || desc.includes(keywordLower);
				}

				card.style.display = phaseMatch && sceneMatch && viewMatch && searchMatch ? 'block' : 'none';
			});

			const visibleCards = cards
				.filter((card) => card.style.display !== 'none')
				.sort((a, b) => {
					if (currentSort === 'newest') {
						const dateA = Number(a.dataset.pubdate || 0);
						const dateB = Number(b.dataset.pubdate || 0);
						return dateB - dateA;
					}
					if (currentSort === 'popular') {
						const likesA = Number(a.dataset.likes || 0);
						const likesB = Number(b.dataset.likes || 0);
						return likesB - likesA;
					}
					return Number(a.dataset.timelineOrder ?? 0) - Number(b.dataset.timelineOrder ?? 0);
				});
			const hiddenCards = cards.filter((card) => card.style.display === 'none');
			if (knowhowContainer) {
				visibleCards.forEach((card) => knowhowContainer.appendChild(card));
				hiddenCards.forEach((card) => knowhowContainer.appendChild(card));
			}

			const myCount = cards.filter((card) => startedChecklistIds.has(card.dataset.checklistId ?? '')).length;
			emptyState?.classList.toggle('hidden', visibleCards.length > 0);
			if (emptyMessage) {
				emptyMessage.textContent = currentListView === 'my' && myCount === 0
					? 'まだ始めたチェックリストはありません。'
					: '条件に一致するチェックリストはありません。';
			}
		}

		sheetPhaseButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const phase = btn.dataset.sheetPhase as PhaseFilter;
				setPhase(currentPhase === phase ? 'all' : phase);
				updateSheetUi();
			});
		});

		sheetSceneButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const scene = btn.dataset.sheetScene as SceneFilter;
				setScene(currentScene === scene ? 'all' : scene);
				updateSheetUi();
			});
		});

		sheetResetBtn?.addEventListener('click', () => {
			currentSort = 'recommend';
			isFavOnly = currentListView === 'my';
			searchKeyword = '';
			if (searchInput) searchInput.value = '';
			setPhase('all');
			setScene('all');
			closeSheetModal();
		});

		sheetApplyBtn?.addEventListener('click', () => {
			const selectedRadio = sheetSortRadios.find((r) => r.checked);
			if (selectedRadio) currentSort = selectedRadio.value as SortOption;
			if (sheetFavOnlyCheckbox) isFavOnly = sheetFavOnlyCheckbox.checked;
			updateView();
			closeSheetModal();
		});

		let searchDebounce: number | undefined;
		searchInput?.addEventListener('input', () => {
			window.clearTimeout(searchDebounce);
			searchDebounce = window.setTimeout(() => {
				searchKeyword = searchInput.value;
				updateView();
			}, 250);
		});

		phaseButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const phase = button.dataset.phase as PhaseFilter;
				if (validPhases.has(phase)) setPhase(phase);
			});
		});
		sceneButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const scene = button.dataset.scene as SceneFilter;
				if (validScenes.has(scene)) setScene(currentScene === scene ? 'all' : scene);
			});
		});
		displayModeButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const mode = button.dataset.displayModeOption as DisplayMode;
				if (mode === 'grid_view' || mode === 'headline_view') setDisplayMode(mode, true);
			});
		});
		const refreshFromSavedRuns = async () => {
			const runs = await getPrivateChecklistRuns();
			startedChecklistIds = new Set(runs.map((run) => run.checklistId));
			updateView();
		};
		window.addEventListener('checklist-runs-changed', () => void refreshFromSavedRuns());

		const syncLikesCount = async () => {
			const slugs = cards.map((c) => `knowhow/${c.dataset.id}`);
			try {
				const statesMap = await getBatchArticleLikeStates(slugs);
				userLikedSlugs = new Set();
				statesMap.forEach((state, slug) => {
					if (state.liked) userLikedSlugs.add(slug);
					const id = slug.replace('knowhow/', '');
					const card = cards.find((c) => c.dataset.id === id);
					if (card) card.dataset.likes = String(state.likeCount);

					document.querySelectorAll(`[data-like-count-for="${id}"]`).forEach((countEl) => {
						countEl.textContent = String(state.likeCount);
					});

					document.querySelectorAll<HTMLElement>(`[data-like-icon-for="${id}"]`).forEach((iconEl) => {
						iconEl.classList.toggle('text-pink-500', state.liked);
						iconEl.style.fontVariationSettings = state.liked ? "'FILL' 1" : "'FILL' 0";
					});
				});
				updateView();
			} catch {}
		};

		window.addEventListener('article-liked', (e: Event) => {
			const customEv = e as CustomEvent<Record<string, any>>;
			if (customEv.detail) {
				const targetSlug = String(customEv.detail.slug || '');
				const isLiked = Boolean(customEv.detail.liked || customEv.detail.isLiked);
				const likeCount = Number(customEv.detail.likeCount || 0);
				const id = targetSlug.replace('knowhow/', '');

				if (isLiked) userLikedSlugs.add(targetSlug);
				else userLikedSlugs.delete(targetSlug);

				const card = cards.find((c) => c.dataset.id === id);
				if (card) card.dataset.likes = String(likeCount);

				document.querySelectorAll<HTMLElement>(`[data-like-count-for="${id}"]`).forEach((countEl) => {
					countEl.textContent = String(likeCount);
				});

				document.querySelectorAll<HTMLElement>(`[data-like-icon-for="${id}"]`).forEach((iconEl) => {
					iconEl.classList.toggle('text-pink-500', isLiked);
					iconEl.style.fontVariationSettings = isLiked ? "'FILL' 1" : "'FILL' 0";
				});
			}
		});

		refreshPhaseButtons();
		refreshSceneButtons();
		refreshDisplayMode();
		updateView();
		updateUrl(false);
		void syncLikesCount();
		void initializePrivateDb().then(async () => {
			if (!initialModeFromUrl) {
				const savedDisplayMode = await getPrivateSetting<DisplayMode>(DISPLAY_MODE_SETTING_KEY);
				if (savedDisplayMode === 'grid_view' || savedDisplayMode === 'headline_view') {
					setDisplayMode(savedDisplayMode, false, false);
				}
			}
			if (!hasInitialPhase) {
				const savedPhase = await getPrivateSetting<PhaseFilter>(PHASE_SETTING_KEY);
				if (savedPhase && validPhases.has(savedPhase)) {
					setPhase(savedPhase, false, false);
				}
			}
			await refreshFromSavedRuns();
		}).catch(() => {
			if (emptyMessage && currentListView === 'my') {
				emptyMessage.textContent = 'このブラウザーではマイリストを読み込めませんでした。';
			}
		});
	});
</script>

