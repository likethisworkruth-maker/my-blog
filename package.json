{
  "name": "@example/blog",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "validate:checklists": "node scripts/validate-checklists.mjs",
    "test": "node --experimental-strip-types --test tests/checklist-state.test.mjs tests/private-data.test.mjs tests/site-contract.test.mjs tests/fixtures-contract.test.mjs tests/cdc-data.test.mjs tests/cdc-user-storage.test.mjs tests/knowhow-sort.test.mjs",
    "test:checklists": "npm test",
    "test:ui": "playwright test",
    "build": "npm run validate:checklists && astro build",
    "postbuild": "node scripts/postbuild.js",
    "preview": "astro preview",
    "astro": "astro",
    "test:anonymous": "playwright test tests/ui/anonymous tests/ui/knowhow-navigation.spec.ts",
    "test:authenticated": "playwright test tests/ui/authenticated",
    "test:auth:setup": "node scripts/prepare-e2e-auth.mjs",
    "test:regression": "npm run build && npm run test && npm run test:anonymous && npm run test:authenticated"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@supabase/supabase-js": "^2.110.1",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.6",
    "idb": "^8.0.3",
    "material-symbols": "^0.45.5",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "fake-indexeddb": "^6.2.5",
    "workbox-build": "^7.4.1"
  }
}
